<?xml version="1.0" encoding="utf-8"?>
<mg:TitleWindow xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
    xmlns:mg="library://ns.mignari.com/mg" width="{idleMode?590:510}" height="{idleMode?530:420}"
    title="{tr(idleMode?'idleAnimation':'breathing')}" close="generateHandler=null">
    <fx:Metadata>[ResourceBundle("strings")]</fx:Metadata>
    <fx:Script><![CDATA[
        import mx.collections.ArrayList;
        public var generateHandler:Function;
        [Bindable] public var idleMode:Boolean=false;
        public var regions:Array = [];
        [Bindable] public var directionCount:int = 1;
        [Bindable] public var regionCount:int = 0;
        [Bindable] public var currentDirection:int = 0;
        [Bindable] public var currentRegion:Boolean = false;
        [Bindable] private var errorText:String = "";
        private function tr(key:String):String {return resourceManager.getString("strings","studio."+key);}
        private function generate():void {
            var oneDirection:Boolean=idleMode&&directionCount>1&&onlyDirection.selected;
            var activeRegions:Array=regions;
            if(oneDirection)activeRegions=regions.filter(function(region:Object,index:int,all:Array):Boolean{return region.direction==currentDirection;});
            if(manual.selected && activeRegions.length != (oneDirection?1:directionCount)){errorText=tr(oneDirection?"idleNeedDirectionRegion":"breathingNeedRegions");return;}
            var timing:Array=legacyTiming.selected?[100,100,100,100]:[int(neutral.value),int(inhale.value),int(expanded.value),int(exhale.value)];
            var handler:Function=generateHandler;
            var parameters:Object={amplitude:int(amplitude.value),durationsMs:timing,regionMode:manual.selected?"rectangle":"auto",regions:manual.selected?regions:[]};
            if(idleMode){
                var count:int=int(idleFrames.value);var values:Array=idleDurations.text.split(",");timing=[];
                if(!legacyTiming.selected&&values.length!=count){errorText=tr("idleTimingError");return;}
                for(var i:int=0;i<count;i++){
                    var value:String=legacyTiming.selected?"100":String(values[i]).replace(/^\s+|\s+$/g,"");
                    var ms:Number=Number(value);
                    if(!/^\d+$/.test(value)||ms<10||ms>10000){errorText=tr("idleTimingError");return;}timing.push(ms);
                }
                if(!idleBreathing.selected&&!idleBobbing.selected&&!idleSway.selected){errorText=tr("idleMotionError");return;}
                parameters={breathing:idleBreathing.selected,bobbing:idleBobbing.selected,sway:idleSway.selected,
                    breathingAmplitude:int(breathAmp.value),bobbingAmplitude:int(bobAmp.value),swayAmplitude:int(swayAmp.value),
                    frameCount:count,durationsMs:timing,anchorBase:anchorBase.selected,regionMode:manual.selected?"rectangle":"auto",regions:manual.selected?activeRegions:[]};
                if(oneDirection)parameters.direction=currentDirection;
            }
            close();if(handler!=null)handler(parameters);
        }
        private function presetChanged():void {
            var i:int=preset.selectedIndex;idleBreathing.selected=[0,3,4,6].indexOf(i)>=0;
            idleBobbing.selected=[1,3,5,6].indexOf(i)>=0;idleSway.selected=[2,4,5,6].indexOf(i)>=0;
        }
        private function presets():ArrayList {
            var breath:String=tr("breathing");
            return new ArrayList([breath,"Bobbing","Sway",breath+" + Bobbing",breath+" + Sway","Bobbing + Sway",tr("idleAll")]);
        }
        private function directionLabel(direction:int):String {
            return tr("idleOnlyDirection")+" ("+["N","E","S","W"][direction]+")";
        }
        private function resetDurations():void {var list:Array=[];for(var i:int=0;i<idleFrames.value;i++)list.push(idleFrames.value==4?(i%2==0?500:300):100);idleDurations.text=list.join(", ");}
    ]]></fx:Script>
    <s:VGroup left="14" right="14" top="14" bottom="14" gap="10">
        <s:Label width="100%" text="{tr(idleMode?'idleHint':'breathingHint')}" maxDisplayedLines="3"/>
        <s:HGroup verticalAlign="middle" visible="{!idleMode}" includeInLayout="{!idleMode}"><s:Label text="{tr('breathingAmplitude')}"/><s:NumericStepper id="amplitude" minimum="1" maximum="2" value="1" width="65"/><s:Label text="px"/></s:HGroup>
        <s:VGroup width="100%" gap="8" visible="{idleMode}" includeInLayout="{idleMode}">
            <s:HGroup verticalAlign="middle"><s:Label text="{tr('idlePreset')}"/>
                <s:DropDownList id="preset" width="240" selectedIndex="0" change="presetChanged()" dataProvider="{presets()}"/>
            </s:HGroup>
            <s:HGroup verticalAlign="middle"><s:CheckBox id="idleBreathing" label="{tr('breathing')}" selected="true" width="220"/><s:NumericStepper id="breathAmp" minimum="1" maximum="2" value="1" width="65"/><s:Label text="px"/></s:HGroup>
            <s:HGroup verticalAlign="middle"><s:CheckBox id="idleBobbing" label="{tr('idleBobbing')}" width="220"/><s:NumericStepper id="bobAmp" minimum="1" maximum="2" value="1" width="65"/><s:Label text="px"/></s:HGroup>
            <s:HGroup verticalAlign="middle"><s:CheckBox id="idleSway" label="{tr('idleSway')}" width="220"/><s:NumericStepper id="swayAmp" minimum="1" maximum="2" value="1" width="65"/><s:Label text="px"/></s:HGroup>
            <s:HGroup verticalAlign="middle"><s:Label text="{tr('idleFrames')}"/><s:NumericStepper id="idleFrames" minimum="3" maximum="16" value="4" width="65" change="resetDurations()"/></s:HGroup>
            <s:HGroup width="100%" verticalAlign="middle" enabled="{!legacyTiming.selected}"><s:Label text="ms"/><s:TextInput id="idleDurations" width="100%" text="500, 300, 500, 300" toolTip="{tr('idleTimingError')}"/></s:HGroup>
            <s:CheckBox id="anchorBase" label="{tr('idleAnchor')}" selected="true"/>
            <s:CheckBox id="onlyDirection" visible="{directionCount>1}" includeInLayout="{directionCount>1}"
                label="{directionLabel(currentDirection)}"/>
        </s:VGroup>
        <s:CheckBox id="manual" label="{tr('breathingManual')}" toolTip="{tr('breathingRegionHint')}"/>
        <s:Label text="{tr('breathingRegions') + ': ' + (idleMode &amp;&amp; onlyDirection.selected ? (currentRegion ? '1 / 1' : '0 / 1') : regionCount + ' / ' + directionCount)}"/>
        <s:Label visible="{!idleMode}" includeInLayout="{!idleMode}" text="{tr('breathingNeutral') + ' / ' + tr('breathingInhale') + ' / ' + tr('breathingExpanded') + ' / ' + tr('breathingExhale')}"/>
        <s:HGroup verticalAlign="middle" visible="{!idleMode}" includeInLayout="{!idleMode}" enabled="{!legacyTiming.selected}">
            <s:Label text="ms"/>
            <s:NumericStepper id="neutral" minimum="10" maximum="10000" value="500" width="88" toolTip="{tr('breathingNeutral')}"/>
            <s:NumericStepper id="inhale" minimum="10" maximum="10000" value="300" width="88" toolTip="{tr('breathingInhale')}"/>
            <s:NumericStepper id="expanded" minimum="10" maximum="10000" value="500" width="88" toolTip="{tr('breathingExpanded')}"/>
            <s:NumericStepper id="exhale" minimum="10" maximum="10000" value="300" width="88" toolTip="{tr('breathingExhale')}"/>
        </s:HGroup>
        <s:CheckBox id="legacyTiming" label="{tr(idleMode?'idleLegacy':'breathingLegacy')}"/>
        <s:Label width="100%" text="{tr('breathingCompatibility')}" maxDisplayedLines="3"/>
        <s:Label width="100%" visible="{idleMode}" includeInLayout="{idleMode}" text="{tr('idleGroupHint')}" maxDisplayedLines="2"/>
        <s:Label width="100%" text="{errorText}"/>
        <s:HGroup width="100%"><s:Spacer width="100%"/><s:Button id="generateButton" label="{tr('breathingGenerate')}" click="generate()"/><s:Button label="{tr('close')}" click="close()"/></s:HGroup>
    </s:VGroup>
</mg:TitleWindow>
