<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark">
    <!-- Both existing GroupBox implementations extend BorderContainer. Their labelDisplay contract is unchanged. -->
    <fx:Metadata>[HostComponent("spark.components.BorderContainer")]</fx:Metadata>
    <fx:Script><![CDATA[
        override protected function updateDisplayList(w:Number, h:Number):void {
            super.updateDisplayList(w, h);
            // Some legacy group boxes have a non-bindable label accessor.
            if (hostComponent && "label" in hostComponent) labelDisplay.text = Object(hostComponent).label;
        }
    ]]></fx:Script>
    <s:states><s:State name="normal"/><s:State name="disabled"/></s:states>
    <s:Rect left="0" right="0" top="0" bottom="0" radiusX="6">
        <s:fill><s:SolidColor color="0x16232F"/></s:fill>
        <s:stroke><s:SolidColorStroke color="0x2C3C4D"/></s:stroke>
    </s:Rect>
    <s:Rect left="1" right="1" top="1" height="31" radiusX="5">
        <s:fill><s:SolidColor color="0x1B2937"/></s:fill>
    </s:Rect>
    <s:Label id="labelDisplay" text="{Object(hostComponent).label}" left="12" right="10" top="10" fontSize="12" fontWeight="bold"
        color="0xF0F5FB" maxDisplayedLines="1"/>
    <s:Group id="contentGroup" left="1" right="1" top="34" bottom="1" minWidth="0" minHeight="0"/>
</s:Skin>
