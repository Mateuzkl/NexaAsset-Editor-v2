<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" xmlns:mx="library://ns.adobe.com/flex/mx" clipAndEnableScrolling="true">
    <fx:Metadata>[HostComponent("nail.components.navigation.TabNavigator")]</fx:Metadata>
    <fx:Script><![CDATA[
        import nail.components.navigation.TabNavigatorButton;
        override protected function updateDisplayList(w:Number, h:Number):void {
            super.updateDisplayList(w, h);
            // The legacy navigator sets compact tab dimensions; only enlarge their presentation.
            for (var i:int = 0; i < buttonsGroup.numElements; i++) {
                var button:TabNavigatorButton = buttonsGroup.getElementAt(i) as TabNavigatorButton;
                if (button) {
                    button.minWidth = 112; button.minHeight = 36;
                    button.width = 112; button.height = 36;
                }
            }
        }
    ]]></fx:Script>
    <s:states><s:State name="normal"/><s:State name="disabled"/></s:states>
    <s:HGroup id="buttonsGroup" left="0" top="0" right="0" height="36" gap="4"/>
    <s:Rect left="0" right="0" top="37" height="1"><s:fill><s:SolidColor color="0x2C3C4D"/></s:fill></s:Rect>
    <mx:ViewStack id="viewStack" left="0" right="0" top="42" bottom="0" minHeight="0" minWidth="0" clipContent="true" creationPolicy="all"/>
</s:Skin>
