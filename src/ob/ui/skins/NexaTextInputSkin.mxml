<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
    minWidth="20" minHeight="20" alpha.disabled="0.5">
    <fx:Metadata>[HostComponent("spark.components.TextInput")]</fx:Metadata>
    <s:states><s:State name="normal"/><s:State name="disabled"/><s:State name="normalWithPrompt"/><s:State name="disabledWithPrompt"/></s:states>
    <s:Rect left="0" right="0" top="0" bottom="0" radiusX="4">
        <s:fill><s:SolidColor color="0x101C29"/></s:fill>
        <s:stroke><s:SolidColorStroke color="0x2C3C4D"/></s:stroke>
    </s:Rect>
    <s:RichEditableText id="textDisplay" left="6" right="6" top="3" bottom="3"
        verticalAlign="middle" color="0xF0F5FB"/>
    <s:Label id="promptDisplay" left="6" right="6" top="3" bottom="3" verticalAlign="middle"
        color="0x8498AC" mouseEnabled="false" mouseChildren="false" includeIn="normalWithPrompt,disabledWithPrompt"/>
</s:Skin>
