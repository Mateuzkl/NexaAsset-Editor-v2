<?xml version="1.0" encoding="utf-8"?>
<s:VGroup xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" width="100%" height="100%" gap="10">
    <fx:Metadata>[Event(name="modernFlagChange", type="ob.modern.ModernFlagEvent")]</fx:Metadata>
    <fx:Script><![CDATA[
        import mx.collections.ArrayCollection;
        import mx.utils.ObjectProxy;
        import mx.core.FlexGlobals;
        import mx.core.UIComponent;
        import ob.modern.ModernFlagEvent;
        import ob.modern.ModernFlagEditorWindow;
        private var _rows:Array=[];
        [Bindable] public function get rows():Array{return _rows;}
        public function set rows(value:Array):void{_rows=value||[];invalidateProperties();}
        [Bindable] private var visibleRows:ArrayCollection=new ArrayCollection();
        override protected function commitProperties():void {super.commitProperties();refresh();}
        public function refresh():void {
            if(!filter || !presentOnly)return;
            var q:String=filter.text.toLowerCase(), values:Array=[];
            for each(var row:Object in rows)if((!presentOnly.selected || row.present) && (q.length==0 || (row.label+" "+row.number+" "+row.value).toLowerCase().indexOf(q)>=0))values.push(new ObjectProxy(row));
            visibleRows.source=values;
        }
        public function toggle(row:Object,enabled:Boolean):void {dispatchEvent(new ModernFlagEvent(row.number,enabled));}
        public function edit(row:Object):ModernFlagEditorWindow {var window:ModernFlagEditorWindow=new ModernFlagEditorWindow();window.row=row;window.addEventListener(ModernFlagEvent.CHANGE,function(event:ModernFlagEvent):void{event.stopPropagation();dispatchEvent(event.clone());});window.open(FlexGlobals.topLevelApplication as UIComponent);return window;}
    ]]></fx:Script>
    <s:Label text="Modern appearance flags (11.x–15.x)" fontSize="16" fontWeight="bold"/>
    <s:Label width="100%" text="All modern flags are listed. Edit attributes opens the complete typed fields. Changes affect the working copy; original files remain untouched."/>
    <s:HGroup width="100%">
        <s:TextInput id="filter" width="100%" prompt="Search flags by name or field number" change="refresh()"/>
        <s:CheckBox id="presentOnly" label="Present only" selected="false" change="refresh()"/>
    </s:HGroup>
    <s:List id="flagList" width="100%" height="100%" dataProvider="{visibleRows}">
        <s:itemRenderer><fx:Component>
            <s:ItemRenderer width="100%" height="146" autoDrawBackground="false">
                <s:VGroup left="8" right="8" top="6" gap="3">
                    <s:HGroup width="100%">
                    <s:CheckBox label="{data.label + ' (#' + data.number + ')'}" selected="{data.enabled}" visible="{data.editable}" includeInLayout="{data.editable}" change="outerDocument.toggle(data,event.currentTarget.selected)"/>
                    <s:Label text="{data.label + ' (#' + data.number + ')'}" visible="{!data.editable}" includeInLayout="{!data.editable}" fontWeight="bold"/>
                    <s:Spacer width="100%"/><s:Button label="Edit attributes…" visible="{data.structured}" includeInLayout="{data.structured}" click="outerDocument.edit(data)"/>
                    </s:HGroup>
                    <s:TextArea width="100%" height="80" editable="false" text="{data.value}"/>
                    <s:Label width="100%" text="{data.legacy}" color="0xA0B2C4" fontSize="11"/>
                </s:VGroup>
            </s:ItemRenderer>
        </fx:Component></s:itemRenderer>
    </s:List>
</s:VGroup>
