<?xml version="1.0" encoding="utf-8"?>
<s:VGroup xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" width="100%" height="100%" gap="10">
    <fx:Script><![CDATA[
        import mx.collections.ArrayCollection;
        import mx.utils.ObjectProxy;
        private var _rows:Array=[];
        [Bindable] public function get rows():Array{return _rows;}
        public function set rows(value:Array):void{_rows=value||[];invalidateProperties();}
        [Bindable] private var visibleRows:ArrayCollection=new ArrayCollection();
        override protected function commitProperties():void{super.commitProperties();refresh();}
        public function refresh():void{if(!filter)return;var values:Array=[],q:String=filter.text.toLowerCase();for each(var row:Object in rows)if(!q.length || (row.label+" "+row.value).toLowerCase().indexOf(q)>=0)values.push(new ObjectProxy(row));visibleRows.source=values;}
    ]]></fx:Script>
    <s:Label text="Native appearance and sprite metadata" fontSize="16" fontWeight="bold"/>
    <s:Label width="100%" text="Read-only structure: names, descriptions, groups, patterns, bounding boxes, sprite IDs and animation timing. Editable flags are in Properties."/>
    <s:TextInput id="filter" width="100%" prompt="Search metadata by name or value" change="refresh()"/>
    <s:List id="metadataList" width="100%" height="100%" dataProvider="{visibleRows}">
        <s:itemRenderer><fx:Component><s:ItemRenderer width="100%" height="118" autoDrawBackground="false">
            <s:VGroup left="8" right="8" top="6" gap="5"><s:Label width="100%" text="{data.label}" fontWeight="bold"/>
                <s:TextArea width="100%" height="84" text="{data.value}" editable="false"/></s:VGroup>
        </s:ItemRenderer></fx:Component></s:itemRenderer>
    </s:List>
</s:VGroup>
