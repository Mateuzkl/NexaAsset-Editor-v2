            private function nativeBitmap(bitmap:BitmapData, target:Object=null):void
            {
                var encoder:Base64Encoder=new Base64Encoder();encoder.insertNewLines=false;var pixels:ByteArray=bitmap.getPixels(bitmap.rect);encoder.encodeBytes(pixels);pixels.clear();
