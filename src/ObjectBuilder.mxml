            private function onCopySprite():void
            {
                if (!clientLoaded)
                    return;
            
                var data:SpriteData = activeSpriteList.selectedSprite;
                if (data)
                {
                    var bitmap:BitmapData = data.getBitmap(0xFFFF00FF);
                    Clipboard.generalClipboard.clear();
                    Clipboard.generalClipboard.setData(ClipboardFormats.BITMAP_FORMAT, bitmap);
                    if(_nativeSource && data is ob.modern.ModernSpriteData){
                        var native:ob.modern.ModernSpriteData=data as ob.modern.ModernSpriteData,pixels:ByteArray=new ByteArray();pixels.writeBytes(native.pixels);pixels.position=0;
                        Clipboard.generalClipboard.setData(NATIVE_SPRITE_CLIPBOARD,{width:native.imageWidth,height:native.imageHeight,pixels:pixels},true);
                    }
                }
            }
            
            private function onPasteSprite():void
            {
                if (_nativeSource) {
                    if(Clipboard.generalClipboard.hasFormat(NATIVE_SPRITE_CLIPBOARD)){
                        var copied:Object=Clipboard.generalClipboard.getData(NATIVE_SPRITE_CLIPBOARD),raw:ByteArray=copied ? copied.pixels as ByteArray : null;
                        if(!raw || [32,64].indexOf(copied.width)<0 || [32,64].indexOf(copied.height)<0 || raw.length!=copied.width*copied.height*4){appendLog("Invalid native sprite clipboard payload.");return;}
                        var encoded:Base64Encoder=new Base64Encoder();encoded.insertNewLines=false;encoded.encodeBytes(raw);
                        nativeMutation("native-sprite-set",{width:copied.width,height:copied.height,argb:encoded.toString(),spriteId:activeSpriteList.selectedId});
                    }else if(Clipboard.generalClipboard.hasFormat(ClipboardFormats.BITMAP_FORMAT))nativeBitmap(BitmapData(Clipboard.generalClipboard.getData(ClipboardFormats.BITMAP_FORMAT)),activeSpriteList.selectedId);
                    return;
                }
                if (!clientLoaded)
                    return;
            
                if (Clipboard.generalClipboard.hasFormat(ClipboardFormats.BITMAP_FORMAT))
                {
                    var bitmap:BitmapData = BitmapData(Clipboard.generalClipboard.getData(ClipboardFormats.BITMAP_FORMAT));
                    bitmap = SpriteUtils.removeMagenta(bitmap);
            
                    if (bitmap.width == SpriteExtent.DEFAULT_SIZE && bitmap.height == SpriteExtent.DEFAULT_SIZE)
                    {
                        if (!activeSpriteList.multipleSelected && activeSpriteList.selectedId != 0)
                        {
                            var pixels:ByteArray = bitmap.getPixels(bitmap.rect);
                            var spriteData:SpriteData = SpriteData.createSpriteData(activeSpriteList.selectedId, pixels);
                            sendCommand(new ReplaceSpritesCommand(Vector.<SpriteData>([spriteData])));
                        }
                    }
                }
            }
            
