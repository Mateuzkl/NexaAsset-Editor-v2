            public function fillSpritesInThing(sprites:Vector.<SpriteData>):void
            {
                if (_nativeSource) {if(sprites.length!=1){Alert.show("Select one native sprite to assign to the current frame, pattern and layer.","Native sprite assignment",Alert.OK,this);return;}var fields:Object=thingTypeEditor.nativeSelection();fields.category=thingTypeEditor.thingData.category;fields.appearanceId=thingTypeEditor.thingData.id;fields.spriteId=sprites[0].id;nativeMutation("native-link-sprite",fields);return;}
                var length:uint = thingTypeEditor.buttonsContainer.numElements;
                if (sprites.length != length)
                {
                    openErrorWindow(resourceManager.getString("strings", "spritesLengthDifferent", [length, sprites.length]));
                    return;
                }
            
                for (var id:uint = 0; id < length; id++)
                {
                    var button:Button = thingTypeEditor.buttonsContainer.getElementAt(id) as Button;
                    var index:int = int(button.label);
                    var spriteData:SpriteData = sprites[id];
                    if (spriteData)
                    {
                        thingTypeEditor.bindableThingType.setSprite(thingTypeEditor.frameGroupSlider.value, index, spriteData);
                    }
                }
            
                thingTypeEditor.updatePreview();
                if (_settings.autosaveThingChanges)
                {
                    saveThingChanges();
                }
            }
            
