            private function doSaveThingChanges(forceReplaceSprites:Boolean = false):void
            {
                if (thingTypeEditor.saveChanges())
                {
                    var thingData:ThingData = thingTypeEditor.thingData;
                    var hasNewSprites:Boolean = thingData.sprites && thingData.sprites[0] &&
                            thingData.sprites[0].length > 0 && thingData.sprites[0][0].id == uint.MAX_VALUE;

                    if (forceReplaceSprites)
                    {
                        sendCommand(new UpdateThingCommand(thingData, true));
                        return;
                    }

                    if (hasNewSprites)
                    {
                        Alert.show(
                                resourceManager.getString("strings", "wantToReplaceSprites"),
                                "",
                                Alert.YES | Alert.NO,
                                this,
                                closeHandler);
                        return;
                    }

                    function closeHandler(event:CloseEvent):void
                    {
                        if (thingTypeEditor && thingTypeEditor.thingData)
                            sendCommand(new UpdateThingCommand(thingTypeEditor.thingData, (event.detail == Alert.YES)));
                    }

                    sendCommand(new UpdateThingCommand(thingData, false));
                }
            }
            
