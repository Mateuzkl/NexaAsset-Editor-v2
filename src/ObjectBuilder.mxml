            public function get clipboardAction():uint
            {
                return _settings.thingListClipboardAction;
            }
            
            public function get hasClipboardObject():Boolean
            {
                return thingList && thingList.hasClipboardObject;
            }
            
            public function get hasClipboardProperties():Boolean
            {
                return thingList && thingList.hasClipboardProperties;
            }
            
