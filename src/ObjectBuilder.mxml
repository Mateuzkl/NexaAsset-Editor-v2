            public function studioEditorRequest(method:String,args:Object,callback:Function):void {
                if(!clientLoaded){callback(null,"Open a project first.");return;}
                var sessionId:String=_studioProjectId;
                if(method=="commit_art"){
                    if(locked||thingTypeEditor.changed||_nativeSaving){callback(null,"Finish the active editor operation and save inspector changes before applying art.");return;}
                    var bytes:ByteArray=ob.studio.StudioPixels.decode(args.packet);
                    if(bytes.length>2097152){bytes.clear();callback(null,"Art packet exceeds 2 MiB.");return;}
                    bytes.position=0;var packet:Object=JSON.parse(bytes.readUTFBytes(bytes.length));
                    if(packet.projectSessionId!=sessionId){bytes.clear();callback(null,"PROJECT_CONFLICT: draft belongs to another project.");return;}
                }
                function finish(result:Object,error:String=null):void {
                    if(sessionId!=_studioProjectId){callback(null,"Project session expired.");return;}
                    if(!error&&method=="get_project_info"){result.projectSessionId=sessionId;result.pendingInspectorChanges=thingTypeEditor.changed;}
                    if(!error&&method=="commit_art"){currentCategory=result.category;sendCommand(new GetThingListCommand(result.selected,result.category));sendCommand(new GetSpriteListCommand(result.sprite));sendCommand(new GetThingCommand(result.selected,result.category));}
                    callback(result,error);
                }
                if(_nativeSource){
                    var source:ModernNativeSource=_nativeSource;
                    if(!source.ready){finish(null,"Native helper is unavailable.");return;}
                    if(method=="get_project_info"){finish({revision:source.revision,format:"modern",clientVersion:null,inventory:source.inventory,capabilities:{read:true,drafts:true,newAsset:true,animatedNewAsset:true,replace:false,save:false,destructive:false,maxCells:64,maxLayers:16,timing:true}});return;}
                    var fields:Object={},file:File;
                    if(method=="commit_art"){
                        file=source.session.directory.resolvePath("art-"+mx.utils.UIDUtil.createUID().split("-").join("").toLowerCase()+".json");
                        if(file.exists){bytes.clear();finish(null,"Temporary art packet collision.");return;}
                        var stream:flash.filesystem.FileStream=new flash.filesystem.FileStream();
                        try{stream.open(file,flash.filesystem.FileMode.WRITE);stream.writeBytes(bytes);}finally{stream.close();bytes.clear();}
                        fields={file:file.nativePath,sha256:args.sha256,expectedRevision:packet.expectedRevision};
                    }else{for(var key:String in args)fields[key]=args[key];fields.action=method;}
                    function clean():void {if(file&&file.exists)try{file.deleteFile();}catch(ignore:Error){}}
                    try{source.enqueue("studio:"+(++_studioSequence),method=="commit_art"?"native-art-commit":"native-studio-read",fields,function(result:Object):void {
                        clean();if(_nativeSource!=source){finish(null,"Native session expired.");return;}
                        if(method=="commit_art"){source.query="";nativeSearchInput.text="";}
                        finish(result);
                    },function():void {clean();finish(null,"Native Studio operation failed. Check the editor status; refresh before retrying.");});}catch(error:Error){clean();finish(null,error.message);}
                }else{
                    var id:String=String(++_studioSequence);
                    var timer:uint=setTimeout(function():void {var pending:Object=_studioRequests[id];delete _studioRequests[id];if(pending)pending.callback(null,"Editor worker request timed out. Refresh before retrying.");},25000);
                    _studioRequests[id]={callback:finish,timer:timer};
                    if(method=="commit_art")bytes.clear();
                    try{_communicator.sendCommand(new ob.commands.StudioCommand(id,method,JSON.stringify(method=="commit_art"?packet:args)));}
                    catch(error:Error){clearTimeout(timer);delete _studioRequests[id];finish(null,error.message);}
                }
            }

