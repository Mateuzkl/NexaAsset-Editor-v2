            protected function getPrevDisplayedThingId():int
            {
                if (objectsViewStack && objectsViewStack.selectedIndex == 2)
                    return foundNeighborId(-1);
                return _currentPrevPageId;
            }

            protected function getNextDisplayedThingId():int
            {
                if (objectsViewStack && objectsViewStack.selectedIndex == 2)
                    return foundNeighborId(1);
                return _currentNextPageId;
            }

            // Positional neighbor in the found list. Clamps to the CURRENT selected id at the
            // ends so the stepper button becomes a no-op (current == value suppresses CHANGE),
            // never falling through to the stepper's page-math.
            private function foundNeighborId(delta:int):int
            {
                if (!foundThingsList || foundThingsList.isEmpty)
                    return -1;

                var len:int = foundThingsList.length;
                var idx:int = foundThingsList.selectedIndex;
                if (idx < 0)
                {
                    idx = (delta > 0) ? 0 : len - 1;
                }
                else
                {
                    var target:int = idx + delta;
                    if (target >= 0 && target < len)
                        idx = target;
                }
                return foundThingsList.getObjectAt(idx).id;
            }
            
