                        toolTip="Reset Zoom (1:1)"
                        width="24" height="24"
                        icon="{NexaIcons.EXPAND}"
                        click="zoomResetButtonClickHandler(event)"/>
                </s:HGroup>

                <nail:GroupBox id="thingViewGroup"
                    label="{resourceManager.getString('strings', 'nexa.itemPreview')}"
                    width="100%" height="100%" minHeight="140"
                    nativeDragEnter="thingDataNativeDragEnterHandler(event)"
                    nativeDragDrop="thingDataNativeDragDropHandler(event)">
                    <s:Scroller id="previewScroller"
                        width="100%" height="100%"
                        mouseWheel="previewMouseWheelHandler(event)">
                        <s:Group>
                            <otlib:ThingDataView id="thingView"
                                horizontalCenter="0"
                                verticalCenter="0"
                                minSize="160"/>
                        </s:Group>
                    </s:Scroller>
                </nail:GroupBox>

                <mg:GroupCheckBox id="colorizeGroupCheckBox"
                    label="Colorize"
                    width="100%"
                    visible="{_isOutfit}"
                    includeInLayout="{_isOutfit}"
                    enabled="{_canColorize}"
                    change="updateColorize()">
                    <s:Group width="100%" enabled="{colorizeGroupCheckBox.selected}">
                        <s:layout>
                            <s:VerticalLayout padding="5" gap="5"/>
                        </s:layout>
                        <s:HGroup gap="15" width="100%">
                            <!-- Left column: Head, Legs, Addons -->
                            <s:VGroup gap="5">
                                <s:HGroup verticalAlign="middle">
                                    <s:Label text="Head:" width="50" textAlign="right"/>
                                    <otlib:HSIColorPicker id="headColorPicker" change="updateColorize()"/>
                                </s:HGroup>
                                <s:HGroup verticalAlign="middle">
                                    <s:Label text="Legs:" width="50" textAlign="right"/>
                                    <otlib:HSIColorPicker id="legsColorPicker" change="updateColorize()"/>
                                </s:HGroup>
                                <s:HGroup verticalAlign="middle">
                                    <s:Label text="Addons:" width="50" textAlign="right"/>
                                    <s:NumericStepper id="addonsColorStepper" minimum="0" maximum="3" change="updateColorize()"/>
                                </s:HGroup>
                            </s:VGroup>
                            <!-- Right column: Body, Feet -->
                            <s:VGroup gap="5">
                                <s:HGroup verticalAlign="middle">
                                    <s:Label text="Body:" width="40" textAlign="right"/>
                                    <otlib:HSIColorPicker id="bodyColorPicker" change="updateColorize()"/>
                                </s:HGroup>
                                <s:HGroup verticalAlign="middle">
                                    <s:Label text="Feet:" width="40" textAlign="right"/>
                                    <otlib:HSIColorPicker id="feetColorPicker" change="updateColorize()"/>
                                </s:HGroup>
                                <s:HGroup verticalAlign="middle" horizontalAlign="right" width="100%">
                                    <s:Button id="randomizeColorsButton"
                                        toolTip="Randomize Colors"
                                        width="22" height="22"
                                        icon="{Assets.EDIT}"
                                        click="randomizeColorsHandler(event)"/>
                                    <s:Button id="copyXmlLookButton"
                                        toolTip="Copy XML Look"
                                        width="22" height="22"
                                        icon="{Assets.MINI_COPY}"
                                        click="copyXmlLookHandler(event)"/>
                                </s:HGroup>
                            </s:VGroup>
                        </s:HGroup>
                    </s:Group>
                </mg:GroupCheckBox>
                </s:VGroup>
                </s:Scroller>
            </s:BorderContainer>

            <!-- thing list container -->
            <s:BorderContainer id="thingsPanel"
                minWidth="255" maxWidth="1340" width="310" height="100%"
                fontSize="12">
                <s:layout>
                    <s:VerticalLayout horizontalAlign="center" padding="5" gap="7"/>
                </s:layout>

                <nail:GroupBox id="objectListGroupBox"
                    label="{resourceManager.getString('strings', 'objects')}"
                    width="100%" height="100%">
                    <nail:layout>
                        <s:VerticalLayout paddingRight="0" paddingLeft="0" paddingTop="5" paddingBottom="0" gap="3"/>
                    </nail:layout>

                    <!-- List/Grid/Found toggle -->
                    <s:HGroup width="100%" horizontalAlign="left" verticalAlign="middle" paddingLeft="5" paddingRight="5">
                        <s:ToggleButton id="listViewButton"
                            label="{resourceManager.getString('strings', 'list')}"
                            width="33%" height="30" selected="true"
                            click="setObjectsView(0)"/>
                        <s:ToggleButton id="gridViewButton"
                            label="{resourceManager.getString('strings', 'grid')}"
                            width="33%" height="30" selected="false"
                            click="setObjectsView(1)"/>
                        <s:ToggleButton id="foundViewButton"
                            label="{resourceManager.getString('strings', 'found')}"
                            width="34%" height="30" selected="false"
                            click="setObjectsView(2)"/>
                    </s:HGroup>

                    <!-- Reuse the existing finder; do not introduce a new search/parser pipeline. -->
                    <s:Button width="100%" height="30"
                        label="{resourceManager.getString('strings', 'nexa.searchObjects')}"
                        toolTip="{resourceManager.getString('strings', 'find')}"
                        icon="{NexaIcons.SEARCH}" click="openFinder()"/>

                    <!-- Hide empty checkbox -->
                    <s:HGroup id="nativeSearch" width="100%" visible="false" includeInLayout="false">
                        <s:TextInput id="nativeSearchInput" width="100%" prompt="ID or name" maxChars="256" enter="searchNativeObjects()"/>
                        <s:Button label="Search" click="searchNativeObjects()"/>
                    </s:HGroup>
                    <s:HGroup width="100%" paddingLeft="5">
                        <s:CheckBox id="hideEmptyObjectsCheckbox"
                            label="{resourceManager.getString('strings', 'hideEmptyObjects')}"
                            selected="false"
                            change="hideEmptyObjectsChangeHandler(event)"/>
                    </s:HGroup>

                    <!-- ViewStack switches between List/Grid/Found -->
                    <mx:ViewStack id="objectsViewStack" width="100%" height="100%" selectedIndex="0"
                        creationPolicy="all">
                        <s:NavigatorContent width="100%" height="100%">
                            <otlib:ThingList id="thingList"
                                width="100%"
                                height="100%"
                                fontSize="11"
                                borderAlpha="0"
                                contentBackgroundColor="0x16232F"
                                horizontalScrollPolicy="off"
                                doubleClickEnabled="true"
                                allowMultipleSelection="true"
                                requireSelection="true"
                                replace="replaceThingHandler(event)"
                                export="exportThingHandler(event)"
                                duplicate="duplicateThingHandler(event)"
                                bulkEdit="bulkEditHandler(event)"
                                edit="editThingHandler(event)"
                                compare="compareThingHandler(event)"
                                copyObject="copyObjectHandler(event)"
                                pasteObject="pasteObjectHandler(event)"
                                copyProperties="copyPropertiesHandler(event)"
                                pasteProperties="pastePropertiesHandler(event)"
                                copyPatterns="copyPatternsHandler(event)"
                                pastePatterns="pastePatternsHandler(event)"
                                copyAttributes="copyAttributesHandler(event)"
                                pasteAttributes="pasteAttributesHandler(event)"
                                remove="removeThingHandler(event)"
                                doubleClick="thingListDoubleClickHandler(event)"
                                change="thingListChangeHandler(event)"
                                nativeDragEnter="thingDataNativeDragEnterHandler(event)"
                                nativeDragDrop="thingDataNativeDragDropHandler(event)"/>
                        </s:NavigatorContent>

                        <s:NavigatorContent width="100%" height="100%">
                            <s:VGroup width="100%" height="100%" gap="3">
                                <s:HGroup width="100%" verticalAlign="middle" paddingLeft="5" paddingRight="5">
                                    <s:Label text="Columns:"/>
                                    <s:NumericStepper id="gridColumnsStepper"
                                        minimum="2" maximum="20" value="4"
                                        width="50" height="20"
                                        change="gridColumnsChangeHandler(event)"/>
                                    <s:Label text="Size:"/>
                                    <s:NumericStepper id="gridIconSizeStepper"
                                        minimum="16" maximum="128" value="54" stepSize="2"
                                        width="60" height="20"
                                        change="gridIconSizeChangeHandler(event)"/>
                                </s:HGroup>

                                <otlib:ThingList id="thingGridList"
                                    width="100%"
                                    height="100%"
                                    fontSize="11"
                                    borderAlpha="0"
                                    contentBackgroundColor="0x16232F"
                                    horizontalScrollPolicy="off"
                                    doubleClickEnabled="true"
                                    allowMultipleSelection="true"
                                    requireSelection="true"
                                    replace="replaceThingHandler(event)"
                                    export="exportThingHandler(event)"
                                    duplicate="duplicateThingHandler(event)"
                                    bulkEdit="bulkEditHandler(event)"
                                    edit="editThingHandler(event)"
                                    compare="compareThingHandler(event)"
                                    copyObject="copyObjectHandler(event)"
                                    pasteObject="pasteObjectHandler(event)"
                                    copyProperties="copyPropertiesHandler(event)"
                                    pasteProperties="pastePropertiesHandler(event)"
                                    copyPatterns="copyPatternsHandler(event)"
                                    pastePatterns="pastePatternsHandler(event)"
                                    copyAttributes="copyAttributesHandler(event)"
                                    pasteAttributes="pasteAttributesHandler(event)"
                                    remove="removeThingHandler(event)"
                                    doubleClick="thingListDoubleClickHandler(event)"
                                    change="thingGridListChangeHandler(event)"
                                    nativeDragEnter="thingDataNativeDragEnterHandler(event)"
                                    nativeDragDrop="thingDataNativeDragDropHandler(event)"/>
                            </s:VGroup>
                        </s:NavigatorContent>

                        <s:NavigatorContent width="100%" height="100%">
                            <otlib:ThingList id="foundThingsList"
                                width="100%"
                                height="100%"
                                fontSize="11"
                                borderAlpha="0"
                                contentBackgroundColor="0x16232F"
                                horizontalScrollPolicy="off"
                                doubleClickEnabled="true"
                                allowMultipleSelection="true"
                                requireSelection="true"
                                replace="replaceThingHandler(event)"
                                export="exportThingHandler(event)"
                                duplicate="duplicateThingHandler(event)"
                                bulkEdit="bulkEditHandler(event)"
                                edit="editThingHandler(event)"
                                compare="compareThingHandler(event)"
                                copyObject="copyObjectHandler(event)"
                                pasteObject="pasteObjectHandler(event)"
                                copyProperties="copyPropertiesHandler(event)"
                                pasteProperties="pastePropertiesHandler(event)"
                                copyPatterns="copyPatternsHandler(event)"
                                pastePatterns="pastePatternsHandler(event)"
                                copyAttributes="copyAttributesHandler(event)"
                                pasteAttributes="pasteAttributesHandler(event)"
                                remove="removeThingHandler(event)"
                                doubleClick="thingListDoubleClickHandler(event)"
                                change="foundThingsListChangeHandler(event)"
                                nativeDragEnter="thingDataNativeDragEnterHandler(event)"
                                nativeDragDrop="thingDataNativeDragDropHandler(event)"/>
                        </s:NavigatorContent>
                    </mx:ViewStack>
                </nail:GroupBox>

                <otlib:AmountNumericStepper id="thingStepper"
                    width="100%"
                    value="{thingList.selectedId}"
                    change="thingStepperChangeHandler(event)"/>
                <s:Group width="100%" height="22">
                    <s:HGroup horizontalCenter="0" verticalCenter="0" gap="3">
                        <s:Button id="replaceThingButton"
                            toolTip="{resourceManager.getString('strings', 'replace')}"
                            width="22"
                            height="22"
                            icon="{Assets.REPLACE}"
                            click="replaceThingHandler(event)"/>
                        <s:Button id="importThingButton"
                            toolTip="{resourceManager.getString('strings', 'import')}"
                            width="22"
                            height="22"
                            icon="{Assets.IMPORT}"
                            click="importThingHandler(event)"/>
                        <s:Button id="exportThingButton"
                            toolTip="{resourceManager.getString('strings', 'export')}"
                            width="22"
                            height="22"
                            icon="{Assets.EXPORT}"
                            click="exportThingHandler(event)"/>
                        <s:Button id="exportAllThingButton"
                            toolTip="{resourceManager.getString('strings', 'exportAll')}"
                            width="22"
                            height="22"
                            icon="{Assets.EXPORT_ALL}"
                            click="exportAllThingsHandler(event)"/>
                        <s:Button id="editThingButton"
                            toolTip="{resourceManager.getString('strings', 'edit')}"
                            width="22"
                            height="22"
                            icon="{Assets.EDIT}"
                            click="editThingHandler(event)"/>
                        <s:Button id="duplicateThingButton"
                            toolTip="{resourceManager.getString('strings', 'duplicate')}"
                            width="22"
                            height="22"
                            icon="{Assets.DUPLICATE}"
                            click="duplicateThingHandler(event)"/>
                        <s:Button id="newThingButton"
                            toolTip="{resourceManager.getString('strings', 'new')}"
                            width="22"
                            height="22"
                            icon="{Assets.NEW}"
                            click="newThingHandler(event)"/>
                        <s:Button id="removeThingButton"
                            toolTip="{resourceManager.getString('strings', 'remove')}"
                            width="22"
                            height="22"
                            icon="{Assets.DELETE}"
                            click="removeThingHandler(event)"/>
                    </s:HGroup>
                    <s:Button id="findThingButton"
                        right="3"
                        verticalCenter="0"
                        toolTip="{resourceManager.getString('strings', 'find')}"
                        width="22"
                        height="22"
                        icon="{Assets.BINOCULARS}"
                        click="openFindWindowHandler(event)"/>
                </s:Group>
            </s:BorderContainer>

            <!-- ThingType editor -->
            <s:Group id="editorPanel" minWidth="400" width="100%" height="100%">
                <s:layout>
                    <s:VerticalLayout gap="-1"/>
                </s:layout>

                <s:BorderContainer width="100%"
                    height="100%">
                    <otlib:ThingTypeEditor id="thingTypeEditor"
                        width="100%"
                        height="100%"
                        visible="false"
                        thingChange="thingChangedHandler(event)"
                        thingPropertyChange="thingPropertyChangedHandler(event)"
                        spriteDoubleClick="thingSpriteDoubleClickHandler(event)"
                        replaceFromPng="replaceThingFromPNGHandler(event)"
                        nativeDragEnter="thingEditorDragEnterHandler(event)"
                        nativeDragDrop="thingEditorDragDropHandler(event)"/>
                </s:BorderContainer>

                <s:BorderContainer width="100%"
                    backgroundColor="0x111D2A"
                    borderColor="0x2C3C4D">
                    <s:layout>
                        <s:HorizontalLayout horizontalAlign="right"
                            verticalAlign="middle"
                            paddingLeft="10"
                            paddingRight="10"
                            paddingTop="3"
                            paddingBottom="3"/>
                    </s:layout>
                    <s:Button id="confirmButton"
                        label="{resourceManager.getString('strings', 'save')}"
                        fontSize="11"
                        height="20"
                        enabled="false"
                        click="confirmButtonClickHandler(event)"/>
                    <s:Button id="cancelButton"
                        label="{resourceManager.getString('strings', 'close')}"
                        fontSize="11"
                        height="20"
                        enabled="false"
                        click="cancelButtonClickHandler(event)"/>
                </s:BorderContainer>
            </s:Group>

            <!-- sprites container -->
            <s:BorderContainer id="spritesPanel"
                minWidth="210"
                maxWidth="900"
                width="220"
                height="100%">
                <s:layout>
                    <s:VerticalLayout horizontalAlign="center" padding="5" gap="5"/>
                </s:layout>

                <nail:GroupBox label="{resourceManager.getString('strings', 'sprites')}"
                    width="100%" height="100%">
                    <nail:layout>
                        <s:VerticalLayout paddingRight="0" paddingLeft="0" paddingTop="5" paddingBottom="0" gap="3"/>
                    </nail:layout>

                    <!-- List/Grid toggle -->
                    <s:HGroup width="100%" horizontalAlign="left" verticalAlign="middle" paddingLeft="5" paddingRight="5">
                        <s:ToggleButton id="spriteListViewButton"
                            label="{resourceManager.getString('strings', 'list')}"
                            width="50%" height="30" selected="true"
                            click="setSpritesView(0)"/>
                        <s:ToggleButton id="spriteGridViewButton"
                            label="{resourceManager.getString('strings', 'grid')}"
                            width="50%" height="30" selected="false"
                            click="setSpritesView(1)"/>
                    </s:HGroup>

                    <mx:ViewStack id="spritesViewStack" width="100%" height="100%" selectedIndex="0"
                        creationPolicy="all">
                        <!-- Index 0: List -->
                        <s:NavigatorContent width="100%" height="100%">
                            <otlib:SpriteList id="spritesList"
                                width="100%"
                                height="100%"
                                allowMultipleSelection="true"
                                dragEnabled="true"
                                fontSize="11"
                                borderAlpha="0"
                                contentBackgroundColor="0x16232F"
                                requireSelection="true"
                                change="spritesListChangeHandler(event)"
                                copy="onCopySprite()"
                                paste="onPasteSprite()"
                                fill="fillThingHandler(event)"
                                replace="replaceSpriteHandler(event)"
                                export="exportSpriteHandler(event)"
                                exportAll="exportAllSpritesHandler(event)"
                                remove="removeSpriteHandler(event)"
                                nativeDragEnter="spritesListNativeDragEnterHandler(event)"
                                nativeDragDrop="spritesListNativeDragDropHandler(event)"/>
                        </s:NavigatorContent>
                        <!-- Index 1: Grid -->
                        <s:NavigatorContent width="100%" height="100%">
                            <s:VGroup width="100%" height="100%" gap="3">
                                <s:HGroup width="100%" verticalAlign="middle" paddingLeft="5" paddingRight="5">
                                    <s:Label text="Columns:"/>
                                    <s:NumericStepper id="spriteGridColumnsStepper"
                                        minimum="2" maximum="20" value="5"
                                        width="50" height="20"
                                        change="spriteGridColumnsChangeHandler(event)"/>
                                    <s:Label text="Size:"/>
                                    <s:NumericStepper id="spriteGridIconSizeStepper"
                                        minimum="16" maximum="128" value="33" stepSize="1"
                                        width="60" height="20"
                                        change="spriteGridIconSizeChangeHandler(event)"/>
                                </s:HGroup>
                                <otlib:SpriteList id="spritesGridList"
                                    width="100%"
                                    height="100%"
                                    allowMultipleSelection="true"
                                    dragEnabled="true"
                                    borderAlpha="0"
                                    contentBackgroundColor="0x16232F"
                                    itemRenderer="otlib.components.renders.SpriteGridRenderer"
                                    change="spritesListChangeHandler(event)"
                                    copy="onCopySprite()"
                                    paste="onPasteSprite()"
                                    fill="fillThingHandler(event)"
                                    replace="replaceSpriteHandler(event)"
                                    export="exportSpriteHandler(event)"
                                    exportAll="exportAllSpritesHandler(event)"
                                    remove="removeSpriteHandler(event)"
                                    nativeDragEnter="spritesListNativeDragEnterHandler(event)"
                                    nativeDragDrop="spritesListNativeDragDropHandler(event)">
                                    <otlib:layout>
                                        <s:TileLayout horizontalGap="1" verticalGap="1"
                                            requestedColumnCount="5" useVirtualLayout="true"/>
                                    </otlib:layout>
                                </otlib:SpriteList>
                            </s:VGroup>
                        </s:NavigatorContent>
                    </mx:ViewStack>
                </nail:GroupBox>

                <otlib:AmountNumericStepper id="spriteStepper"
                    width="100%"
                    value="{spritesList.selectedId}"
                    change="spriteStepperChangeHandler(event)"/>

                <s:HGroup width="100%" horizontalAlign="center" verticalAlign="middle" gap="3">
                    <s:Button id="pixelArtStudioButton" label="Pixel Art / MCP" enabled="{nexaActions.loaded}" click="openPixelArtStudio()"/>

                    <s:Button id="replaceSpriteButton"
                        toolTip="{resourceManager.getString('strings', 'replace')}"
                        width="22"
                        height="22"
                        icon="{Assets.REPLACE}"
                        click="replaceSpriteHandler(event)"/>
                    <s:Button id="importSpriteButton"
                        toolTip="{resourceManager.getString('strings', 'import')}"
                        width="22"
                        height="22"
                        icon="{Assets.IMPORT}"
                        click="importSpriteHandler(event)"/>
                    <s:Button id="exportSpriteButton"
                        toolTip="{resourceManager.getString('strings', 'export')}"
                        width="22"
                        height="22"
                        icon="{Assets.EXPORT}"
                        click="exportSpriteHandler(event)"/>
                    <s:Button id="exportAllSpriteButton"
                        toolTip="{resourceManager.getString('strings', 'exportAll')}"
                        width="22"
                        height="22"
                        icon="{Assets.EXPORT_ALL}"
                        click="exportAllSpritesHandler(event)"/>
                    <s:Button id="copySpriteButton"
                        toolTip="{resourceManager.getString('strings', 'copy')}"
                        width="22"
                        height="22"
                        icon="{Assets.MINI_COPY}"
                        click="onCopySprite()"/>
                    <s:Button id="pasteSpriteButton"
                        toolTip="{resourceManager.getString('strings', 'paste')}"
                        width="22"
                        height="22"
                        icon="{Assets.MINI_PASTE}"
                        click="onPasteSprite()"/>
                    <s:Button id="newSpriteButton"
                        toolTip="{resourceManager.getString('strings', 'new')}"
                        width="22"
                        height="22"
                        icon="{Assets.NEW}"
                        click="newSpriteButtonClickHandler(event)"/>
                    <s:Button id="removeSpriteButton"
                        toolTip="{resourceManager.getString('strings', 'remove')}"
                        width="22"
                        height="22"
                        icon="{Assets.DELETE}"
                        click="removeSpriteHandler(event)"/>
                </s:HGroup>
            </s:BorderContainer>
        </mx:HDividedBox>

        <!-- Log Panel at bottom -->
        <otlib:LogPanel id="logPanel"
            width="100%" height="150"
            minHeight="30"
            dataProvider="{_logs}"
            clear="logPanelClearHandler(event)"/>
    </mx:VDividedBox>
    <s:BorderContainer width="100%" height="26" backgroundColor="0x0A1520" borderColor="0x2C3C4D">
        <s:HGroup left="12" right="12" top="0" bottom="0" verticalAlign="middle" gap="12">
            <s:Label id="statusLabel" text="{resourceManager.getString('strings', 'nexa.ready')}" fontSize="11" color="0xADC0D4"/>
            <s:Spacer width="100%"/>
            <s:Label id="documentLabel" fontSize="11" color="0xADC0D4" maxDisplayedLines="1"/>
            <s:Label text="NexaAsset Editor v2" fontSize="11" color="0x8498AC"/>
        </s:HGroup>
    </s:BorderContainer>
    </s:VGroup>
</s:WindowedApplication>
