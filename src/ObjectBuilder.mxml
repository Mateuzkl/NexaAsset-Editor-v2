            protected function setPreviewZoom(zoom:Number):void
            {
                zoom = Math.max(0.25, Math.min(5.0, zoom));
                _previewZoom = zoom;
                thingView.scaleX = zoom;
                thingView.scaleY = zoom;
            }

            protected function zoomInButtonClickHandler(event:MouseEvent):void
            {
                setPreviewZoom(_previewZoom + 0.25);
            }

