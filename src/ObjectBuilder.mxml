            protected function exportSpriteHandler(event:Event):void
            {
                if (_nativeSource) { nativeExport(true); return; }
                if (!clientLoaded || _locked)
                    return;
            
                var sprites:Vector.<SpriteData> = activeSpriteList.selectedSprites;
                if (sprites.length == 0)
                    return;

                _locked = false;
            
                var window:ExportWindow = new ExportWindow();
                window.fileName = "sprite";
                window.format = _settings.getLastExportSpriteFormat();
                window.directory = _settings.getIODirectory();
                window.enableObdFormat = false;
                window.transparentBackground = _settings.exportWithTransparentBackground;
                window.jpegQuality = _settings.jpegQuality;
                window.addEventListener(Event.CLOSE, windowCloseHandler);
                window.open(this);
            
                function windowCloseHandler(event:Event):void
                {
                    if (window.detail == DialogDetail.OK && window.fileName != null && window.format != null && window.directory)
                    {
            
                        _settings.setIODirectory(window.directory);
                        _settings.setLastExportSpriteFormat(window.format);
                        _settings.exportWithTransparentBackground = window.transparentBackground;
                        _settings.jpegQuality = window.jpegQuality;
            
                        onExportSprites(window.fileName,
                                window.format,
                                window.directory,
                                sprites,
                                _settings.exportWithTransparentBackground,
                                _settings.jpegQuality);
                    }
                }
            }
            
            protected function exportAllSpritesHandler(event:Event):void
            {
                if (_nativeSource) { Alert.show("Use Export to save selected native sprites as PNG, or Convert DAT/SPR… to export the complete native working copy to DAT/SPR. Whole-catalog PNG export is not implemented.","Native export",Alert.OK,this); return; }
                if (!clientLoaded || _locked)
                    return;

                _locked = true;

                var window:ExportWindow = new ExportWindow();
                window.fileName = "sprite";
                window.format = _settings.getLastExportSpriteFormat();
                window.directory = _settings.getIODirectory();
                window.enableObdFormat = false;
                window.transparentBackground = _settings.exportWithTransparentBackground;
                window.jpegQuality = _settings.jpegQuality;
                window.maxId = _clientInfo.maxSpriteId;
                window.rangeTo = _clientInfo.maxSpriteId;
                window.addEventListener(Event.CLOSE, windowCloseHandler);
                window.open(this);
                var app:ObjectBuilder = this;

                function windowCloseHandler(event:Event):void
                {
                    _locked = false;

                    if (window.detail == DialogDetail.OK && window.fileName != null && window.format != null && window.directory)
                    {
                        _settings.setIODirectory(window.directory);
                        _settings.setLastExportSpriteFormat(window.format);
                        _settings.exportWithTransparentBackground = window.transparentBackground;
                        _settings.jpegQuality = window.jpegQuality;

                        var fromId:uint = window.useRange ? window.rangeFrom : 1;
                        var toId:uint = window.useRange ? window.rangeTo : _clientInfo.maxSpriteId;

                        var queue:FileQueueHelper = new FileQueueHelper();
                        queue.parent = app;
                        queue.addEventListener(Event.COMPLETE, completeHandler);

                        for (var id:uint = fromId; id <= toId; id++)
                        {
                            queue.addFile(id, window.fileName + "_" + id.toString(), window.format, window.directory);
                        }
                        queue.start();

                        function completeHandler(event:Event):void
                        {
                            if (queue.result && queue.result.length > 0)
                            {
                                exportSprites(queue.result,
                                    _settings.exportWithTransparentBackground,
                                    _settings.jpegQuality);
                            }
                        }
                    }
                }
            }

