            protected function replaceThingHandler(event:Event):void
            {
                if (_nativeSource) { nativeImport(false,true); return; }
                if (!clientLoaded)
                    return;

                var src:ThingList = (event.target as ThingList) || getActiveThingList();
                var filter:FileFilter = new FileFilter("Object Builder Data", "*.obd;");
                var file:File = _settings.getIODirectory() || File.userDirectory;
                file.addEventListener(FileListEvent.SELECT_MULTIPLE, selectMultipleHandler);
                file.browseForOpenMultiple(resourceManager.getString("strings", "selectFiles"), [filter]);

                function selectMultipleHandler(event:FileListEvent):void
                {
                    var selectedIds:Vector.<uint> = src.selectedIds;
                    var files:Array = event.files;
                    var length:uint = files.length;
                    var list:Vector.<PathHelper> = new Vector.<PathHelper>(length, true);
            
                    if (selectedIds.length != files.length)
                    {
                        Alert.show(
                                resourceManager.getString(
                                    "strings",
                                    "invalidFileAmount",
                                    [resourceManager.getString("strings", "objects").toLowerCase()]),
                                resourceManager.getString("strings", "error"));
                        return;
                    }
            
                    OtlibUtils.sortFiles(files, Array.NUMERIC | Array.DESCENDING);
            
                    for (var i:uint = 0; i < length; i++)
                    {
                        list[i] = new PathHelper(files[i].nativePath, selectedIds[i]);
                    }
            
                    if (list.length != 0)
                    {
                        replaceThingsFromFiles(list);
                    }
                }
            }
            
            protected function importThingHandler(event:Event):void
            {
                if (_nativeSource) { nativeImport(); return; }
                if (!clientLoaded || _locked)
                    return;

                _locked = true;

                var window:ImportSelectionWindow = new ImportSelectionWindow();
                window.addEventListener(Event.CLOSE, windowCloseHandler);
                window.open(this);

                function windowCloseHandler(event:Event):void
                {
                    _locked = false;

                    if (window.detail == DialogDetail.OK && window.selectedFiles && window.selectedFiles.length > 0)
                    {
                        var list:Vector.<PathHelper> = window.selectedFiles;
                        if (list.length != 0)
                        {
                            importThingsFromFiles(list);
                        }
                    }
                }
            }
            
            protected function exportThingHandler(event:Event):void
            {
                if (_nativeSource) { nativeExport(); return; }
                if (!clientLoaded || _locked)
                    return;

                var src:ThingList = (event.target as ThingList) || getActiveThingList();
                var things:Vector.<ThingType> = src.selectedThings;
                if (things.length == 0)
                    return;
            
                var version:Version = _settings.getLastExportThingVersion();
                if (!version)
                    version = _versionStorage.getFromClientInfo(_clientInfo);
            
                _locked = true;
            
                var window:ExportWindow = new ExportWindow();
                window.enableObdFormat = true;
                window.enableModernFormat = true;
                window.fileName = currentCategory;
                window.directory = _settings.getIODirectory();
                window.format = _settings.getLastExportThingFormat();
                window.version = version;
                window.transparentBackground = _settings.exportWithTransparentBackground;
                window.jpegQuality = _settings.jpegQuality;
                window.obdV3 = thingData.category == ThingCategory.OUTFIT && _clientInfo.frameGroups;
                window.addEventListener(Event.CLOSE, windowCloseHandler);
                window.open(this);
            
                function windowCloseHandler(event:Event):void
                {
                    _locked = false;
            
                    if (window.detail == DialogDetail.OK && window.fileName != null && window.directory && window.format != null && window.version)
                    {
                        if(window.format=="modern") {
                            var target:File=window.directory.resolvePath(window.fileName);
                            if(target.parent.nativePath.toLowerCase()!=window.directory.nativePath.toLowerCase()){Alert.show("Choose a new child folder for modern assets.","Modern export",Alert.OK,this);return;}
                            var ids:Vector.<uint>=new Vector.<uint>();for each(var selected:ThingType in things)ids.push(selected.id);
                            exportSelectedModernProject(ids,things[0].category,target);return;
                        }
                        _settings.setIODirectory(window.directory);
                        _settings.setLastExportThingFormat(window.format);
                        _settings.setLastExportThingVersion(window.version);
                        _settings.exportWithTransparentBackground = window.transparentBackground;
                        _settings.jpegQuality = window.jpegQuality;
            
                        onExportThingData(window.fileName,
                                window.format,
                                window.directory,
                                window.version,
                                window.obdVersion,
                                things,
                                thingData.category,
                                _settings.savingSpriteSheet,
                                _settings.exportWithTransparentBackground,
                                _settings.jpegQuality);
                    }
                }
            }
            
            protected function exportAllThingsHandler(event:Event):void
            {
                if (_nativeSource) { openNativeConversion(); return; }
                if (!clientLoaded || _locked)
                    return;

                var version:Version = _settings.getLastExportThingVersion();
                if (!version)
                    version = _versionStorage.getFromClientInfo(_clientInfo);

                _locked = true;

                var window:ExportWindow = new ExportWindow();
                window.enableObdFormat = true;
                window.enableModernFormat = true;
                window.fileName = currentCategory;
                window.directory = _settings.getIODirectory();
                window.format = _settings.getLastExportThingFormat();
                window.version = version;
                window.transparentBackground = _settings.exportWithTransparentBackground;
                window.jpegQuality = _settings.jpegQuality;
                window.obdV3 = currentCategory == ThingCategory.OUTFIT && _clientInfo.frameGroups;
                window.showCategorySelector = true;
                window.selectedCategory = currentCategory;
                window.categoryMaxIds = {
                    item: _clientInfo.maxItemId,
                    outfit: _clientInfo.maxOutfitId,
                    effect: _clientInfo.maxEffectId,
                    missile: _clientInfo.maxMissileId
                };
                window.maxId = getMaxThingId();
                window.rangeTo = getMaxThingId();
                window.addEventListener(Event.CLOSE, windowCloseHandler);
                window.open(this);

                function windowCloseHandler(event:Event):void
                {
                    _locked = false;

                    if (window.detail == DialogDetail.OK && window.fileName != null && window.directory && window.format != null && window.version)
                    {
                        _settings.setIODirectory(window.directory);
                        _settings.setLastExportThingFormat(window.format);
                        _settings.setLastExportThingVersion(window.version);
                        _settings.exportWithTransparentBackground = window.transparentBackground;
                        _settings.jpegQuality = window.jpegQuality;

                        var category:String = window.selectedCategory ? window.selectedCategory : currentCategory;
                        var fromId:uint = window.useRange ? window.rangeFrom : getMinThingIdForCategory(category);
                        var toId:uint = window.useRange ? window.rangeTo : getCategoryMaxId(category);
                        if(window.format=="modern") {
                            var target:File=window.directory.resolvePath(window.fileName);
                            if(toId<fromId||toId-fromId>=100||target.parent.nativePath.toLowerCase()!=window.directory.nativePath.toLowerCase()){Alert.show("Select a range of 1–100 objects and a new child folder for modern assets.","Modern export",Alert.OK,this);return;}
                            var ids:Vector.<uint>=new Vector.<uint>();for(var objectId:uint=fromId;objectId<=toId;objectId++)ids.push(objectId);
                            exportSelectedModernProject(ids,category,target);return;
                        }

                        var things:Vector.<ThingType> = new Vector.<ThingType>();
                        for (var id:uint = fromId; id <= toId; id++)
                        {
                            var thing:ThingType = new ThingType();
                            thing.id = id;
                            thing.category = category;
                            things.push(thing);
                        }

                        onExportThingData(window.fileName,
                                window.format,
                                window.directory,
                                window.version,
                                window.obdVersion,
                                things,
                                category,
                                _settings.savingSpriteSheet,
                                _settings.exportWithTransparentBackground,
                                _settings.jpegQuality);
                    }
                }
            }

