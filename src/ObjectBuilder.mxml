            {
                setPreviewZoom(1.0);
            }

            protected function previewMouseWheelHandler(event:MouseEvent):void
            {
                if (event.ctrlKey)
                {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    var delta:Number = event.delta > 0 ? 0.1 : -0.1;
                    setPreviewZoom(_previewZoom + delta);
                }
