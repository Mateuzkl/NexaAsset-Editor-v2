            protected function creationCompleteHandler(event:FlexEvent):void
            {
                toobar.communicator = _communicator;
            
                loadSettings();
                loadVersions();
                loadSpriteDimensions();
            
                // Explicitly initialize registry
                var attrPath:String = File.applicationDirectory.resolvePath("config/attributes").nativePath;
                _attributeRegistry.initialize(attrPath);
            
                loadAttributes(); // Initializes ItemAttributeStorage
            
                thingTypeEditor.settings = _settings;
                thingTypeEditor.bindableThingType.settings = _settings;
                thingList.clipboardAction = _settings.thingListClipboardAction;
                thingGridList.clipboardAction = _settings.thingListClipboardAction;
                foundThingsList.clipboardAction = _settings.thingListClipboardAction;

                // Initialize grid view mode
                thingGridList.gridColumns = gridColumnsStepper.value;
                thingGridList.viewMode = ThingList.VIEW_MODE_GRID;
            
                // Refresh attributes UI now that settings and registry are loaded
                thingTypeEditor.refreshAttributeServer();
            
                _logTarget.writeStart();
            
                // Restore log panel state from settings
                logPanel.expanded = _settings.showLogPanel;

                // Global error handler — prevents silent crashes
                if (loaderInfo && loaderInfo.uncaughtErrorEvents)
                {
                    loaderInfo.uncaughtErrorEvents.addEventListener(
                        UncaughtErrorEvent.UNCAUGHT_ERROR, uncaughtErrorHandler);
                }
            }
            
            protected function applicationCompleteHandler(event:FlexEvent):void
            {
                systemManager.stage.nativeWindow.addEventListener(
                        NativeWindowDisplayStateEvent.DISPLAY_STATE_CHANGING,
                        displayStateChangingHandler);
            
                _splashScreen.setProgress(2, 2);
                _splashScreen = null;
            }
            
            protected function applicationClosingHandler(event:Event):void
            {
                if(studio&&studio.hasUncommittedDrafts){event.preventDefault();statusLabel.text="Export or discard the open Pixel Art Studio drafts before closing the editor.";openPixelArtStudio();return;}
                if(_legacyModernExport){event.preventDefault();statusLabel.text="Wait for the modern project export before closing.";return;}
                if(_nativeSource && (_nativeSaving || clientChanged || _nativeSource.busy || _nativeObjectExportActive)){
                    event.preventDefault();
                    if(_nativeSaving || _nativeSource.busy || _nativeObjectExportActive){statusLabel.text="Wait for the pending native operation before closing.";return;}
                    Alert.show("Save the changes to this modern asset folder before closing?","Unsaved modern assets",Alert.YES|Alert.NO|Alert.CANCEL,this,function(answer:CloseEvent):void {
                        if(answer.detail==Alert.YES){_nativeCloseAfterSave=true;saveNativeProject();}
                        else if(answer.detail==Alert.NO){clear();close();}
                    });return;
                }
                closeFinder();
                closeLookGenerator();
                closeObjectViewer();
                closeSlicer();
                closeAnimationEditor();
                closeAssetStore();
                if (_modernWindow) _modernWindow.close();
                if (_nativeSource) clear();
                if (_bulkEditWindow && !_bulkEditWindow.closed)
                {
                    _bulkEditWindow.removeEventListener(Event.CLOSE, bulkEditCloseHandler);
                    _bulkEditWindow.close();
                    _bulkEditWindow = null;
                }
                saveWindowState();
                saveSettings();
                saveVersions();
            
                _logTarget.writeEnd();
            
                if (clientLoaded && clientChanged)
                {
                    event.preventDefault();
                    Alert.show(
                            resourceManager.getString("strings", "wantToCompile"),
                            "",
                            Alert.YES | Alert.NO | Alert.CANCEL,
                            this,
                            alertCloseHandler);
                }
            
                function alertCloseHandler(event:CloseEvent):void
                {
                    if (event.detail == Alert.YES)
                        compileProject();
                    else if (event.detail == Alert.NO)
                        exit();
                }
            }
            
            protected function uncaughtErrorHandler(event:UncaughtErrorEvent):void
            {
                event.preventDefault();

                var message:String;
                var stackTrace:String = "";

                if (event.error is Error)
                {
                    var error:Error = event.error as Error;
                    message = error.message;
                    stackTrace = error.getStackTrace();
                }
                else if (event.error is ErrorEvent)
                {
                    var errorEvent:ErrorEvent = event.error as ErrorEvent;
                    message = errorEvent.text;
                }
                else
                {
                    message = String(event.error);
                }

                var fullMessage:String = "Uncaught error: " + message;
                if (stackTrace)
                    fullMessage += "\n\n" + stackTrace;

                Log.error(fullMessage);

                var errorWindow:ErrorWindow = new ErrorWindow();
                errorWindow.message = fullMessage;
                errorWindow.open();
                WindowUtil.centralizeWindowOnScreen(errorWindow);

                if (_locked)
                    _locked = false;
            }

