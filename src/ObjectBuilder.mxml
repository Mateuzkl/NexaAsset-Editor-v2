            private function nativeImport(sprite:Boolean=false, replace:Boolean=false):void
            {
                var source:ModernNativeSource = _nativeSource;
                var category:String = currentCategory, target:uint = sprite ? activeSpriteList.selectedId : (thingData ? thingData.id : 0);
                var file:File = _settings.getIODirectory() || source.directory.parent;
                file.addEventListener(Event.SELECT,picked);file.addEventListener(Event.CANCEL,cancelled);file.addEventListener(FileListEvent.SELECT_MULTIPLE,pickedMultiple);
                try {
                    var filters:Array=[new FileFilter(sprite ? "PNG sprite" : "Objects (OBD, AEC, Nexa package or PNG)", sprite ? "*.png" : "*.obd;*.aec;*.nexaobject;*.png")];
                    if(sprite || replace)file.browseForOpen("Import into the native working copy",filters);
                    else file.browseForOpenMultiple("Import native objects (OBD/AEC support batches)",filters);
                }
                catch(error:Error){cleanup();appendLog(error.message);}
                function cleanup():void{file.removeEventListener(Event.SELECT,picked);file.removeEventListener(Event.CANCEL,cancelled);file.removeEventListener(FileListEvent.SELECT_MULTIPLE,pickedMultiple);}
                function cancelled(event:Event):void{cleanup();}
                function pickedMultiple(event:FileListEvent):void {
                    cleanup();if(_nativeSource!=source || !event.files.length)return;
                    if(event.files.length==1){file=event.files[0];picked(new Event(Event.SELECT));return;}
                    var paths:Array=[];
                    for each(var selected:File in event.files){var ext:String=selected.extension ? selected.extension.toLowerCase() : "";if(ext!="obd"&&ext!="aec"){Alert.show("Batch object import accepts OBD and AEC. Import PNG/Nexa packages individually.","Native import",Alert.OK,FlexGlobals.topLevelApplication as UIComponent);return;}paths.push(selected.nativePath);}
                    _settings.setIODirectory(event.files[0]);importNativeObjectFiles(paths);
                }
                function picked(event:Event):void {
                    cleanup();if(_nativeSource!=source)return;_settings.setIODirectory(file);
                    if(!sprite && file.extension && (file.extension.toLowerCase()=="obd" || file.extension.toLowerCase()=="aec")){importNativeObjectFiles([file.nativePath],replace ? target : null);return;}
                    if(file.extension && file.extension.toLowerCase()=="nexaobject") {nativeMutation("native-import-object",{category:category,file:file.nativePath,target:replace ? target : null});return;}
                    if(!sprite && replace){Alert.show("Use OBD, AEC or a Nexa native package to replace an entire object, or replace its PNG sprite in the Sprites panel.","Native import",Alert.OK,FlexGlobals.topLevelApplication as UIComponent);return;}
                    nativeMutation("native-import-png",{category:category,spriteId:replace ? target : null,file:file.nativePath,asObject:!sprite});
                }
            }
