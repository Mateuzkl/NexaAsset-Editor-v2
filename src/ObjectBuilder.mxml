            public function sendCommand(command:WorkerCommand):void
            {
                if (_nativeSource && !(command is ob.commands.things.ExportNativeObjectCommand))
                {
                    var source:ModernNativeSource = _nativeSource;
                    if (command is GetThingListCommand)
                    {
                        var page:GetThingListCommand = GetThingListCommand(command);
                        _nativeTargetId = page.targetId; _nativeTargetCategory = page.category;
                        source.hideEmpty = hideEmptyObjectsCheckbox.selected;
                        source.objects(page.targetId, page.category, function(result:Object, items:Vector.<ThingListItem>):Boolean {
                            if (_nativeSource != source || currentCategory != page.category) return false;
                            var selectedId:uint = result.selected;
                            if (_nativeTargetCategory == page.category && _nativeTargetId != page.targetId)
                            {
                                var present:Boolean = false;
                                for each (var row:ThingListItem in items) if (row.id == _nativeTargetId) { present = true; break; }
                                if (!present) { sendCommand(new GetThingListCommand(_nativeTargetId, page.category)); return false; }
                                selectedId = _nativeTargetId;
                            }
                            setThingListCallback(selectedId ? Vector.<uint>([selectedId]) : new Vector.<uint>(), items, true, result.previous, result.next, true);
                            if (!result.selected) { thingData = null; editThing(null); }
                            if (source.query.length) { foundThingsList.forceNextUpdate(); foundThingsList.setListObjects(items); foundThingsList.selectedIds = selectedId ? Vector.<uint>([selectedId]) : new Vector.<uint>(); }
                            else foundThingsList.removeAll();
                            statusLabel.text = "Modern project · " + result.total + " objects";
                            return true;
                        });
                    }
                    else if (command is GetThingCommand)
                    {
                        var selected:GetThingCommand = GetThingCommand(command);
                        _nativeTargetId = selected.id; _nativeTargetCategory = selected.category;
                        source.detail(selected.id, selected.category, function(data:ModernThingData):Boolean {
                            if (_nativeSource != source || currentCategory != data.category || _nativeTargetId != data.id) return false;
                            setThingDataCallback(data, true);
                            // Reuse the standard inspector, not a separate modern browser.
                            editThing(data);
                            return true;
                        });
                    }
                    else if (command is GetSpriteListCommand)
                        source.sprites(GetSpriteListCommand(command).targetId, function(result:Object, sprites:Vector.<SpriteData>):void {
                            if (_nativeSource == source) setSpriteListCallback(Vector.<uint>([result.selected]), sprites, true, true);
                        });
                    // Never send legacy asset mutation commands
                    // against a modern source or the previously loaded worker project.
                    else if (command is SettingsCommand) _communicator.sendCommand(command);
                    else { statusLabel.text = "This legacy operation is not available in the native working copy. Use Convert DAT/SPR to continue in legacy format."; appendLog(statusLabel.text); }
                    return;
                }
                _communicator.sendCommand(command);
            }
            
            public function setSpriteExtend(dimension:SpriteDimension):void
            {
                if (!dimension)
                    return;
            
                SpriteExtent.DEFAULT_VALUE = dimension.toString();
                SpriteExtent.DEFAULT_SIZE = dimension.size;
                SpriteExtent.DEFAULT_DATA_SIZE = dimension.dataSize;
            
                thingTypeEditor.spriteDimension = dimension;
                sendCommand(new SetSpriteDimensionCommand(dimension.toString(), dimension.size, dimension.dataSize));
            }
            
