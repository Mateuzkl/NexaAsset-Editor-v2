            private function hideProgressBarCallback(id:String):void
            {
                if (_progressWidget)
                {
                    _progressWidget.progress(id, 100, 100, null);
                    // Close the widget when the save/compile bar explicitly hides
                    if (id == ProgressBarID.METADATA || id == ProgressBarID.DEFAULT)
                    {
                        var t:flash.utils.Timer = new flash.utils.Timer(300, 1);
                        t.addEventListener(flash.events.TimerEvent.TIMER, function(e:flash.events.TimerEvent):void {
                            if (_progressWidget) _progressWidget.close();
                        });
                        t.start();
                    }
                }
            }
            
            private function progressCallback(id:String, loaded:uint, total:uint, label:String):void
            {
                if (id == ProgressBarID.FIND || id == ProgressBarID.OPTIMIZE)
                    return;
            
                if (!_progressWidget)
                {
                    _progressWidget = new ReadableProgressWidget();
                    _progressWidget.width = 560;
                    _progressWidget.addEventListener(Event.CLOSE, function closeHandler(event:Event):void
                        {
                            _locked = false;
                            _progressWidget = null;
                        });
                    _progressWidget.open(this);
                    _locked = true;
                }
            
                var phase:String = label || "Working";
                if (_progressPhase != phase || loaded == 0)
                {
                    _progressPhase = phase;
                    _progressStarted = flash.utils.getTimer();
                }
                // Show % for operations with 2+ steps (includes save stages total=3)
                if (total >= 2)
                {
                    var isLong:Boolean = total > 3;
                    var units:uint = isLong ? total - 1 : total; // Long ops reserve last slot for flush
                    var done:uint = Math.min(loaded, units);
                    var percent:int = Math.floor(Number(done) * 100 / Math.max(1, units));
                    var elapsed:Number = (flash.utils.getTimer() - _progressStarted) / 1000;
                    label = phase + "  " + percent + "%";
                    if (isLong) label += "  (" + done + " / " + units + ")";
                    if (isLong && elapsed >= 2 && done > 0 && done < units)
                        label += "  ~" + Math.ceil(elapsed * (units - done) / done) + "s remaining";
                    else if (done == units) label += "  Finalizando...";
                }
                _progressWidget.progress(id, loaded, total, label);
                if (_progressWidget) _progressWidget.fitLabelText();
                // Auto-close METADATA bar when it reaches 100%
                if (id == ProgressBarID.METADATA && total > 0 && loaded >= total)
                {
                    var t:flash.utils.Timer = new flash.utils.Timer(400, 1);
                    t.addEventListener(flash.events.TimerEvent.TIMER, function(e:flash.events.TimerEvent):void {
                        if (_progressWidget) _progressWidget.close();
                    });
                    t.start();
                }
            }
            
            private function logCallback(level:uint, message:String, stack:String, id:uint):void
            {
                if (_progressWidget)
                    _progressWidget.close();
            
                if (level != Log.INFO)
                {
                    var text:String = isNullOrEmpty(stack) ? message : stack;
                    _logTarget.write(text);
                    openErrorWindow(text);
                }
                else
                    appendLog(message);
            }
            
            private function toLogString(level:uint):String
            {
                switch (level)
                {
                    case Log.DEBUG:
                        return resourceManager.getString("strings", "debug");
                    case Log.INFO:
                        return resourceManager.getString("strings", "info");
                    case Log.WARN:
                        return resourceManager.getString("strings", "warn");
                    case Log.ERROR:
                        return resourceManager.getString("strings", "error");
                    case Log.FATAL:
                        return resourceManager.getString("strings", "fatal");
                }
                return "";
            }
            
            private function onSetCategory(category:String):void
            {
                if (["items", "outfits", "effects", "missiles"].indexOf(nexaNavigation.active) >= 0)
                    nexaNavigation.active = category + "s";
                if (clientLoaded)
                {
                    switch (category)
                    {
                        case ThingCategory.ITEM:
                            categoryDropDownList.selectedIndex = 0;
                            break;
                        case ThingCategory.OUTFIT:
                            categoryDropDownList.selectedIndex = 1;
                            break;
                        case ThingCategory.EFFECT:
                            categoryDropDownList.selectedIndex = 2;
                            break;
                        case ThingCategory.MISSILE:
                            categoryDropDownList.selectedIndex = 3;
                            break;
                    }
            
                    thingStepper.minimum = getMinThingId();
                    thingStepper.maximum = getMaxThingId();
            
                    // Use pending edit ID if available, otherwise use minimum
                    var targetId:uint = _pendingEditId > 0 ? _pendingEditId : thingStepper.minimum;
                    _pendingEditId = 0; // Clear after use
            
                    thingStepper.value = targetId;
                    requestThingWithDebounce(targetId, category);
                    sendCommand(new GetThingListCommand(targetId, category));

                    // Update GroupBox label to reflect current category
                    if (objectListGroupBox)
                        objectListGroupBox.label = resourceManager.getString("strings", category + "s");
                }
            }
            
            private function updateTitle(info:String = "", saved:Boolean = true):void
            {
                var text:String = Descriptor.getName();
            
                if (!isNullOrEmpty(info))
                    text += " - " + info;
            
                if (!saved)
                    text += "*";
            
                this.title = text;
                statusLabel.text = resourceManager.getString("strings", saved ? "nexa.ready" : "nexa.unsaved");
                documentLabel.text = info;
            }
            
            private function openErrorWindow(message:String):void
            {
                if (!PopUpWindowManager.currentWindow)
                {
                    var window:ErrorWindow = new ErrorWindow();
                    // window.addEventListener(Event.CLOSE, function(event:Event):void { exit(); });
                    window.open();
                    window.message = message;
            
                    PopUpWindowManager.addWindow(window);
                }
                else if (PopUpWindowManager.currentWindow is ErrorWindow)
                {
                    ErrorWindow(PopUpWindowManager.currentWindow).appendMessage(message);
