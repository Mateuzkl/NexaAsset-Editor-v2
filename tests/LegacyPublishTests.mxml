<?xml version="1.0" encoding="utf-8"?>
<local:ObjectBuilder xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:local="*">
    <fx:Style source="../src/ObjectBuilder.css"/>
    <fx:Script><![CDATA[
        import flash.desktop.NativeApplication;
        import flash.display.BitmapData;
        import flash.display.PNGEncoderOptions;
        import flash.events.InvokeEvent;
        import flash.events.TimerEvent;
        import flash.events.UncaughtErrorEvent;
        import flash.filesystem.File;
        import flash.filesystem.FileMode;
        import flash.filesystem.FileStream;
        import flash.utils.ByteArray;
        import flash.utils.Timer;
        import flash.utils.getTimer;
        import mx.events.FlexEvent;
        import ob.components.OpenAssetsWindow;
        import ob.commands.files.LoadFilesCommand;
        import ob.commands.files.CompileAsCommand;
        import ob.commands.things.GetThingCommand;
        import ob.commands.things.ImportThingsFromFilesCommand;
        import ob.commands.things.ReplaceThingsFromFilesCommand;
        import ob.commands.sprites.ReplaceSpritesFromFilesCommand;
        import otlib.loaders.PathHelper;
        import otlib.core.Version;
        import otlib.core.VersionStorage;
        import otlib.core.SpriteDimension;
        import otlib.core.ClientFeatures;
        import otlib.sprites.SpriteStorage;
        import otlib.sprites.SpriteData;
        import otlib.things.ThingTypeStorage;
        import otlib.things.ThingType;
        import otlib.things.ThingData;
        import otlib.obd.OBDEncoder;
        import otlib.utils.OTFI;
        import otlib.utils.SpriteExtent;
        import otlib.utils.SpriteRetiler;
        private var args:Array, lines:Array = [];
        private var poll:Timer = new Timer(100);
        private var phase:int, started:int;
        private var loggedPhase:int = -1;
        private var folder:File, output:File, copyFolder:File, lock:FileStream;
        private var testVersion:Version, features:ClientFeatures;
        private var probe:OpenAssetsWindow;
        override protected function applicationInvokeHandler(event:InvokeEvent):void { args = event.arguments; }
        override protected function applicationPreinitializeHandler(event:FlexEvent):void {
            systemManager.loaderInfo.uncaughtErrorEvents.addEventListener(UncaughtErrorEvent.UNCAUGHT_ERROR, failed);
            super.applicationPreinitializeHandler(event);
        }
        override protected function applicationCompleteHandler(event:FlexEvent):void {
            super.applicationCompleteHandler(event); started = getTimer(); poll.addEventListener(TimerEvent.TIMER, tick); poll.start();
        }
        private function check(value:Boolean, message:String):void { if (!value) throw new Error(message); }
        private function failed(event:UncaughtErrorEvent):void { event.preventDefault(); finish(new Error("Phase " + phase + ": " + event.error)); }
        private function write(file:File, bytes:ByteArray):void {
            var stream:FileStream = new FileStream(); try { stream.open(file, FileMode.WRITE); stream.writeBytes(bytes); } finally { stream.close(); }
        }
        private function save(size:uint = 64, destination:File = null):void {
            if (!destination) destination = folder;
            sendCommand(new CompileAsCommand(destination.resolvePath("Tibia.dat"), destination.resolvePath("Tibia.spr"), null, "xml", null, testVersion, features, size));
            check(legacyCompiling, "Compile command did not acquire busy state");
        }
        private function fixture():void {
            folder = output.resolvePath("source"); folder.createDirectory(); copyFolder = output.resolvePath("copy32"); copyFolder.createDirectory();
            testVersion = VersionStorage.getInstance().getByValueString("13.10"); check(testVersion != null, "13.10 test profile missing");
            features = new ClientFeatures(true, true, true, true);
            var dimension:SpriteDimension = new SpriteDimension(); dimension.value = "64x64"; dimension.size = 64; dimension.dataSize = 16384; setSpriteExtend(dimension);
            var pixels:ByteArray = new ByteArray(); pixels.length = 16384; pixels[0] = 255; pixels[1] = 17; pixels[2] = 34; pixels[3] = 51;
            var sprites:SpriteStorage = new SpriteStorage(); sprites.createNew(testVersion, features); sprites.replaceSprite(1, pixels);
            var things:ThingTypeStorage = new ThingTypeStorage(settings); things.createNew(testVersion, features);
            var thing:ThingType = things.getItemType(100); thing.getFrameGroup(0).spriteIndex[0] = 1;
            check(things.compileToStaging(folder.resolvePath("Tibia.dat"), testVersion, features), "Fixture DAT failed");
            check(sprites.compileToStaging(folder.resolvePath("Tibia.spr"), testVersion, features), "Fixture SPR failed");
            new OTFI(features, "Tibia.dat", "Tibia.spr", 64, 16384).save(folder.resolvePath("Tibia.otfi"));
            var data:ThingData = new ThingData(); data.obdVersion = 300; data.clientVersion = testVersion.value; data.thing = thing.clone();
            var sprite:SpriteData = new SpriteData(); sprite.id = 1; sprite.pixels = pixels; data.sprites[0] = new <SpriteData>[sprite];
            var encoded:ByteArray = new OBDEncoder(settings).encode(data); write(output.resolvePath("import.obd"), encoded); encoded.clear();
            var bitmap:BitmapData = new BitmapData(64, 64, true, 0); bitmap.setPixel32(0, 0, 0xFF884411);
            encoded = bitmap.encode(bitmap.rect, new PNGEncoderOptions()); write(output.resolvePath("replace.png"), encoded); encoded.clear(); bitmap.dispose();
            sprites.unload(); things.unload(); SpriteRetiler.dispose(data);
            sendCommand(new LoadFilesCommand(folder.resolvePath("Tibia.dat"), folder.resolvePath("Tibia.spr"), testVersion, null, features));
        }
        private function tick(event:TimerEvent):void {
            try {
                if (output && loggedPhase != phase) {
                    loggedPhase = phase; var heartbeat:ByteArray = new ByteArray(); heartbeat.writeUTFBytes("Phase " + phase + ", status=" + statusLabel.text);
                    write(output.resolvePath("phase.txt"), heartbeat); heartbeat.clear();
                }
                check(getTimer() - started < 90000, "Legacy worker timeout at phase " + phase + ", status=" + statusLabel.text);
                if (phase == 0 && visible && running && args) {
                    output = new File(args[0]); output.createDirectory(); fixture(); phase = 1;
                } else if (phase == 1 && clientLoaded) {
                    check(clientInfo.spriteSize == 64, "Worker did not retain 64x64 dimensions");
                    sendCommand(new ImportThingsFromFilesCommand(new <PathHelper>[new PathHelper(output.resolvePath("import.obd").nativePath)])); phase = 2;
                } else if (phase == 2 && clientInfo.maxItemId == 101 && clientChanged) {
                    sendCommand(new GetThingCommand(101, "item")); phase = 3;
                } else if (phase == 3 && thingData && thingData.id == 101) {
                    check(thingData.getFrameGroup(0).width == 1 && thingData.sprites[0][0].pixels.length == 16384, "Standard OBD was not retiled for 64x64 import");
                    sendCommand(new ReplaceSpritesFromFilesCommand(new <PathHelper>[new PathHelper(output.resolvePath("replace.png").nativePath, thingData.sprites[0][0].id)]));
                    sendCommand(new GetThingCommand(101, "item")); phase = 4;
                } else if (phase == 4 && thingData.sprites[0][0].pixels[1] == 136) {
                    save(); createNewProject(); check(legacyCompiling && clientLoaded, "New interrupted a compile"); phase = 5;
                } else if (phase == 5 && !legacyCompiling && !clientChanged) {
                    lines.push("PASS: standard OBD import + PNG replacement + 64x64 Save finishes through the real worker/UI");
                    sendCommand(new ReplaceThingsFromFilesCommand(new <PathHelper>[new PathHelper(output.resolvePath("import.obd").nativePath, 101)]));
                    sendCommand(new GetThingCommand(101, "item")); phase = 6;
                } else if (phase == 6 && clientChanged && thingData.id == 101 && thingData.sprites[0][0].pixels[1] == 17) {
                    lock = new FileStream(); lock.open(folder.resolvePath("Tibia.spr"), FileMode.READ); save(); phase = 7;
                } else if (phase == 7 && !legacyCompiling) {
                    check(clientChanged, "Failed publication discarded edits");
                    lock.close(); lock = null; lines.push("PASS: OBD replace + locked SPR produces terminal failure and retains dirty state"); save(); phase = 8;
                } else if (phase == 8 && !legacyCompiling && !clientChanged) {
                    lines.push("PASS: Save retry succeeds after releasing the lock");
                    sendCommand(new ReplaceSpritesFromFilesCommand(new <PathHelper>[new PathHelper(output.resolvePath("replace.png").nativePath, thingData.sprites[0][0].id)]));
                    sendCommand(new GetThingCommand(101, "item")); phase = 9;
                } else if (phase == 9 && clientChanged && thingData.sprites[0][0].pixels[1] == 136) {
                    save(32, copyFolder); phase = 10;
                } else if (phase == 10 && !legacyCompiling) {
                    check(clientChanged && clientInfo.spriteSize == 64, "32x32 copy export altered or marked 64x64 source saved");
                    var descriptor:OTFI = new OTFI(); check(descriptor.load(copyFolder.resolvePath("Tibia.otfi")) && descriptor.spriteSize == 32, "32x32 output descriptor wrong");
                    lines.push("PASS: lossless 32x32 copy exported while original 64x64 working copy remains dirty/open");
                    probe = new OpenAssetsWindow(); probe.open(this); probe.clientDirectory = new File(args[1]); phase = 11;
                } else if (phase == 11) {
                    probe.validateNow(); if (!probe.loadButton.enabled) return;
                    check(probe.metadataController == "wot64" && probe.spriteDimension.size == 64, "Wot opening UI lost detected layout/profile");
                    check(probe.itemsCountLabel.text == "59479", "Wot opening UI did not display counts");
                    probe.close(); lines.push("PASS: nested Wot folder opening dialog selects 64x64 + scoped Wot profile and displays counts"); finish();
                } else if (phase == 4 || phase == 6 || phase == 9) {
                    // Image/OBD loaders finish asynchronously after the first GetThing response.
                    sendCommand(new GetThingCommand(101, "item"));
                }
            } catch(error:Error) { finish(error); }
        }
        private function finish(error:Error = null):void {
            poll.stop(); if (lock) { lock.close(); lock = null; }
            if (error) lines.push("FAIL: phase " + phase + ": " + error.message + "\n" + error.getStackTrace());
            var bytes:ByteArray = new ByteArray(); bytes.writeUTFBytes(lines.join("\n"));
            if (output) write(output.resolvePath("legacy-publish-result.txt"), bytes); trace(lines.join("\n"));
            NativeApplication.nativeApplication.exit(error ? 1 : 0);
        }
    ]]></fx:Script>
</local:ObjectBuilder>
