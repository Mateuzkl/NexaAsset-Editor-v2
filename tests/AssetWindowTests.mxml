<?xml version="1.0" encoding="utf-8"?>
<s:WindowedApplication xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
    width="1000" height="700" creationComplete="startTest()">
    <fx:Metadata>[ResourceBundle("strings")]</fx:Metadata>
    <fx:Style source="../src/ObjectBuilder.css"/>
    <fx:Script><![CDATA[
        import flash.filesystem.File;
        import flash.filesystem.FileStream;
        import flash.filesystem.FileMode;
        import flash.utils.ByteArray;
        import flash.utils.Endian;
        import mx.resources.ResourceManager;
        import ob.components.OpenAssetsWindow;
        import ob.components.CompileAssetsWindow;
        import ob.components.MergeAssetsWindow;
        import otlib.components.ExportWindow;
        import flash.events.Event;
        import flash.geom.Point;
        import flash.display.BitmapData;
        import flash.display.PNGEncoderOptions;
        import otlib.core.ClientFeatures;
        import otlib.utils.OTFI;
        import otlib.core.Version;
        import otlib.core.VersionStorage;
        import otlib.core.SpriteDimensionStorage;
        import otlib.resources.Resources;
        import otlib.items.ItemAttributeStorage;
        private var fixtureRoot:File;
        private var version:Version;
        private var openWindow:OpenAssetsWindow;
        private var mergeWindow:MergeAssetsWindow;
        private var warningRoot:File;
        private var exportWindow:ExportWindow;
        private function startTest():void
        {
            try
            {
                Resources.manager = ResourceManager.getInstance();
                var testDirectory:File = new File(File.applicationDirectory.nativePath);
                var config:File = testDirectory.parent.resolvePath("src/config");
                VersionStorage.getInstance().load(config.resolvePath("versions.xml"));
                SpriteDimensionStorage.getInstance().load(config.resolvePath("sprites.xml"));
                ItemAttributeStorage.getInstance().initialize(config.resolvePath("attributes").nativePath);
                version = VersionStorage.getInstance().getBySignatures(0x4C2C7993, 0x4C220594);
                if (!version) throw new Error("Missing 8.60 test version.");
                fixtureRoot = testDirectory.resolvePath("windows-" + new Date().time);
                fixtureRoot.createDirectory(); fixtureRoot.resolvePath("FileParts").createDirectory();
                var bytes:ByteArray = buffer();
                bytes.writeUnsignedInt(version.sprSignature); bytes.writeUnsignedInt(1); bytes.writeUnsignedInt(0);
                write(fixtureRoot.resolvePath("FileParts/part_1.spr"), bytes);
                bytes = buffer(); bytes.writeUTFBytes("SPMT"); bytes.writeUnsignedInt(1);
                bytes.writeUnsignedInt(version.sprSignature); bytes.writeUnsignedInt(1); write(fixtureRoot.resolvePath("spr_parts.dat"), bytes);
                bytes = buffer(); bytes.writeUTFBytes("SPIX"); bytes.writeUnsignedInt(1); bytes.writeUnsignedInt(1);
                bytes.writeUnsignedInt(65537); write(fixtureRoot.resolvePath("spr_index.dat"), bytes);
                openWindow = new OpenAssetsWindow(); openWindow.open(this);
                openWindow.clientDirectory = fixtureRoot;
                callLater(verifyMultiOnly);
            }
            catch (error:Error) { fail(error); }
        }
        private function verifyMultiOnly():void
        {
            try
            {
                openWindow.validateNow();
                // v1/v2 share a SPR signature; without DAT only the version family is knowable.
                if (!openWindow.sprFile || openWindow.sprFile.name != "spr_index.dat" || !openWindow.version ||
                    openWindow.version.value != version.value || openWindow.version.sprSignature != version.sprSignature)
                    throw new Error("SPR-only multi-index selection/version failed.");
                openWindow.close();
                var bytes:ByteArray = buffer(); bytes.writeUnsignedInt(version.sprSignature); bytes.writeShort(1); bytes.writeUnsignedInt(0);
                write(fixtureRoot.resolvePath("Tibia.spr"), bytes);
                openWindow = new OpenAssetsWindow(); openWindow.open(this); openWindow.clientDirectory = fixtureRoot;
                callLater(verifyPriority);
            }
            catch (error:Error) { fail(error); }
        }
        private function verifyPriority():void
        {
            try
            {
                openWindow.validateNow();
                if (!openWindow.sprFile || openWindow.sprFile.name != "Tibia.spr")
                    throw new Error("A regular SPR must not be silently overridden by multi-SPR.");
                openWindow.close();
                var compileWindow:CompileAssetsWindow = new CompileAssetsWindow();
                compileWindow.version = version; compileWindow.filesName = "Tibia"; compileWindow.directory = fixtureRoot;
                compileWindow.multiSpr = true; compileWindow.extendedItems = true; compileWindow.open(this); compileWindow.validateNow();
                if (compileWindow.sprFile.name != "spr_index.dat" || !compileWindow.extended || !compileWindow.extendedItems)
                    throw new Error("Multi-SPR output choice or extended items was not preserved.");
                compileWindow.multiSpr = false; compileWindow.validateNow();
                if (compileWindow.sprFile.name != "Tibia.spr") throw new Error("Standard output choice failed.");
                compileWindow.close();
                trace("PASS: SPR-only multi-index load, standard SPR priority, independent output selection");
                prepareWarnings();
            }
            catch (error:Error) { fail(error); }
        }
        private function prepareWarnings():void
        {
            Resources.locale = "pt_BR";
            ResourceManager.getInstance().localeChain = ["pt_BR"];
            warningRoot = fixtureRoot.resolvePath("warnings"); warningRoot.createDirectory();
            var bytes:ByteArray = buffer(); bytes.writeUnsignedInt(version.sprSignature); bytes.writeShort(32);
            for (var id:uint = 1; id <= 32; id++) bytes.writeUnsignedInt(6 + 32 * 4 + (id - 1) * 12);
            for (id = 1; id <= 32; id++)
            {
                bytes.writeByte(255); bytes.writeByte(0); bytes.writeByte(255); bytes.writeShort(7);
                bytes.writeShort(0); bytes.writeShort(1); bytes.writeByte(10); bytes.writeByte(20); bytes.writeByte(30);
            }
            write(warningRoot.resolvePath("Tibia.spr"), bytes);
            bytes = buffer(); bytes.writeUnsignedInt(version.datSignature); bytes.writeShort(100);
            bytes.writeShort(0); bytes.writeShort(0); bytes.writeShort(0); bytes.writeByte(255);
            for (id = 0; id < 7; id++) bytes.writeByte(1);
            bytes.writeShort(1); write(warningRoot.resolvePath("Tibia.dat"), bytes);
            new OTFI(new ClientFeatures(false, false), "Tibia.dat", "Tibia.spr", 32, 4096).save(warningRoot.resolvePath("Tibia.otfi"));
            openWindow = new OpenAssetsWindow(); openWindow.open(this); openWindow.clientDirectory = warningRoot;
            callLater(verifyOpenWarning);
        }
        private function verifyOpenWarning():void
        {
            try
            {
                openWindow.validateNow();
                if (openWindow.transparency || !openWindow.loadButton.enabled || openWindow.featureNotice.visible)
                    throw new Error("RGB auto-detection did not initialize cleanly.");
                openWindow.transparency = true; openWindow.validateNow();
                if (!openWindow.featureNotice.blocksLoad || openWindow.loadButton.enabled)
                    throw new Error("Wrong RGB transparency must display a red warning and block Load.");
                if (openWindow.featureNotice.message.indexOf("Transparência") < 0)
                    throw new Error("Portuguese warning resources were not applied.");
                snapshot("warning-red.png");
                openWindow.transparency = false; openWindow.validateNow();
                if (openWindow.featureNotice.visible || !openWindow.loadButton.enabled)
                    throw new Error("Unchecking Transparency must clear the warning and restore Load.");
                openWindow.extended = true; openWindow.validateNow();
                if (!openWindow.featureNotice.blocksLoad || !openWindow.extended)
                    throw new Error("Manual Extended choice must warn, not silently reload/reset.");
                openWindow.featureNotice.dispatchEvent(new Event(Event.CHANGE)); openWindow.validateNow();
                if (openWindow.extended || !openWindow.loadButton.enabled) throw new Error("Suggested settings did not restore Extended.");
                openWindow.improvedAnimations = true; openWindow.frameGroups = true; openWindow.validateNow();
                if (!openWindow.featureNotice.visible || openWindow.featureNotice.blocksLoad || !openWindow.loadButton.enabled)
                    throw new Error("DAT hints must display yellow and allow a custom configuration.");
                callLater(verifyWarningLayout);
            }
            catch (error:Error) { fail(error); }
        }
        private function verifyWarningLayout():void
        {
            try
            {
                openWindow.validateNow();
                var label:Object = openWindow.featureNotice.messageLabel;
                var bottom:Point = label.localToGlobal(new Point(0, label.height));
                var button:Point = openWindow.loadButton.localToGlobal(new Point(0, 0));
                if (label.width <= 0 || label.height <= 0 || bottom.y > button.y)
                    throw new Error("Warning text overlaps the Load button.");
                snapshot("warning-yellow.png");
                openWindow.featureNotice.dispatchEvent(new Event(Event.CHANGE)); openWindow.validateNow();
                if (openWindow.featureNotice.visible || openWindow.improvedAnimations || openWindow.frameGroups)
                    throw new Error("Suggested DAT flags did not clear the warning.");
                openWindow.close();
                mergeWindow = new MergeAssetsWindow(); mergeWindow.open(this); mergeWindow.clientDirectory = warningRoot;
                callLater(verifyMergeWarning);
            }
            catch (error:Error) { fail(error); }
        }
        private function verifyMergeWarning():void
        {
            try
            {
                mergeWindow.validateNow(); mergeWindow.transparency = true; mergeWindow.validateNow();
                if (!mergeWindow.featureNotice.blocksLoad || mergeWindow.loadButton.enabled)
                    throw new Error("Merge must apply the same transparency safety check.");
                mergeWindow.featureNotice.dispatchEvent(new Event(Event.CHANGE)); mergeWindow.validateNow();
                if (mergeWindow.transparency || !mergeWindow.loadButton.enabled) throw new Error("Merge warning correction failed.");
                mergeWindow.close();
                trace("PASS: Open/Merge red mismatch, checkbox correction, yellow DAT hints, suggested settings, warning layout");
                trace("Warning screenshots: " + fixtureRoot.nativePath);
                exportWindow=new ExportWindow();exportWindow.enableObdFormat=true;exportWindow.enableModernFormat=true;
                exportWindow.fileName="modern-outfit";exportWindow.directory=fixtureRoot.parent;exportWindow.version=version;exportWindow.format="modern";exportWindow.open(this);callLater(verifyModernExport);
            }
            catch (error:Error) { fail(error); }
        }
        private function verifyModernExport():void
        {
            try{
                exportWindow.validateNow();var bottom:Point=exportWindow.modernGroupsInfo.localToGlobal(new Point(0,exportWindow.modernGroupsInfo.height));var button:Point=exportWindow.confirmButton.localToGlobal(new Point());
                if(!exportWindow.modernFormatRadioButton.selected || !exportWindow.confirmButton.enabled || bottom.y>button.y)throw new Error("Modern format/options are missing or clipped.");
                var bitmap:BitmapData=new BitmapData(Math.ceil(exportWindow.width),Math.ceil(exportWindow.height),true,0);try{bitmap.draw(exportWindow);write(fixtureRoot.resolvePath("export-modern.png"),bitmap.encode(bitmap.rect,new PNGEncoderOptions()));}finally{bitmap.dispose();}
                exportWindow.format="obd";exportWindow.validateNow();if(!exportWindow.obdFormatRadioButton.selected || !exportWindow.confirmButton.enabled)throw new Error("Legacy OBD export format regressed.");exportWindow.close();
                trace("PASS: modern appearances format, unclipped instructions and unchanged OBD choice");NativeApplication.nativeApplication.exit(0);
            }catch(error:Error){fail(error);}
        }
        private function snapshot(name:String):void
        {
            var bitmap:BitmapData = new BitmapData(Math.ceil(openWindow.width), Math.ceil(openWindow.height), true, 0);
            try
            {
                bitmap.draw(openWindow);
                write(fixtureRoot.resolvePath(name), bitmap.encode(bitmap.rect, new PNGEncoderOptions()));
            }
            finally { bitmap.dispose(); }
        }
        private function buffer():ByteArray { var b:ByteArray = new ByteArray(); b.endian = Endian.LITTLE_ENDIAN; return b; }
        private function write(file:File, bytes:ByteArray):void
        {
            var stream:FileStream = new FileStream();
            try { stream.open(file, FileMode.WRITE); stream.writeBytes(bytes); } finally { stream.close(); }
        }
        private function fail(error:Error):void { trace("FAIL: " + error.getStackTrace()); NativeApplication.nativeApplication.exit(1); }
    ]]></fx:Script>
</s:WindowedApplication>
